#!/bin/sh
# The Android rig build's smoke check, end to end — the `android-emulator` CI job, and its reproduction on this Linux
# box (the `android-emulator` skill boots the emulator first).
#
#   scripts/android-smoke [apk]      # an emulator booted and reachable over adb; defaults to the rig debug APK
#
# It installs the rig build, launches it, forwards the control channel's port, and asks what only a composed app can
# answer: `/health` (the channel is up and names the fixed adapter choice), `GET /device` (every vocabulary entry
# classified — a 500 names a gap), a UI state read back, and one intent driven to an observable outcome — an event
# created and joined over the mocked backend, the screen showing it. A screenshot of that state is left beside the APK.
#
# The app is the rig build over mocks (`test/rig/src/android-hook`): nothing here reaches a real backend.
set -eu

APK=${1:-app/android/build/outputs/apk/debug/android-debug.apk}
PORT=18099
ADB=${ADB:-adb}
BASE="http://127.0.0.1:$PORT"

say() { printf '%s\n' "android-smoke: $*"; }
fail() { say "FAILED: $*"; "$ADB" logcat -d -s SnapSync:V AndroidRuntime:E | tail -60; exit 1; }

"$ADB" wait-for-device
"$ADB" install -r "$APK" >/dev/null || fail "install $APK"
"$ADB" shell am force-stop app.snapsync
"$ADB" logcat -c
"$ADB" shell am start -W -n app.snapsync/app.snapsync.android.MainActivity >/dev/null || fail "launch"
"$ADB" forward "tcp:$PORT" "tcp:$PORT" >/dev/null

# The server starts once the root has composed; give it up to 60 s.
i=0
until curl -fsS "$BASE/health" >/dev/null 2>&1; do
    i=$((i + 1)); [ "$i" -le 60 ] || fail "the control channel never answered on $BASE/health"; sleep 1
done
curl -fsS "$BASE/health" | sed 's/^/  health: /'

curl -fsS "$BASE/device" >/dev/null || fail "GET /device — a vocabulary entry is unclassified (the body names it): $(curl -sS "$BASE/device")"
say "vocabulary classified"

layer() { curl -fsS "$BASE/device/state" | python3 -c 'import json,sys; print(json.load(sys.stdin)["ui"]["layer"]["type"])'; }
await_layer() {
    i=0
    until [ "$(layer)" = "$1" ]; do
        i=$((i + 1)); [ "$i" -le 30 ] || fail "the screen never reached $1 (it shows $(layer))"; sleep 1
    done
    say "screen: $1"
}

await_layer app.snapsync.model.Layer.CreateEvent
# The mocked clock stands at the epoch, so the window is the epoch's.
curl -fsS -X POST "$BASE/user/create?name=Android%20smoke&startsAt=1970-01-01T00:00&endsAt=1970-01-03T00:00" >/dev/null
await_layer app.snapsync.model.Layer.JoiningEvent
curl -fsS -X POST "$BASE/user/confirmJoin?range=wholeEvent" >/dev/null
await_layer app.snapsync.model.Layer.Joined

"$ADB" exec-out screencap -p > "$(dirname "$APK")/android-smoke-joined.png"
say "PASSED — screenshot at $(dirname "$APK")/android-smoke-joined.png"

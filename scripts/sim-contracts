#!/bin/sh
# Run the simulator app's port contracts, end to end — the `ios-contracts` CI job, and its reproduction on a
# Mac session (`docs/architecture.md`, "In-app hosts CI can reach are run live over the rig").
#
#   scripts/sim-contracts            # on macOS, from the repo root, with snapsync.rig=true in ~/.gradle
#
# It builds the rig app for the simulator, ad-hoc signs it (an unsigned build has no App Group), installs it on
# ONE fresh simulator, grants photo access with applesimutils BEFORE the first launch (`simctl privacy grant
# photos` writes a TCC row PhotoKit never consults), launches it, and runs every contract `GET /contract` lists
# for this host. The contracts seed photos and never delete them, which is why the simulator is fresh.
#
# ONE simulator, never two: a second freshly created simulator's first-boot work swamped the hosted runner (3 vCPU,
# 7 GB). Measured, it tripled the job and made the journeys flaky (decision record:
# `openspec/changes/archive/2026-09-25-one-simulator-journeys`). For the same reason nothing overlaps the build: the
# xcodebuild and the journeys' compile run first, their Gradle and Kotlin daemons are stopped (they hold gigabytes
# the simulator then swaps against), and only then does the simulator boot. A fresh simulator's photo library is not
# writable when it reports booted: `assetsd` migrates its libraries at utility priority, and the app's first write
# waits minutes for it (measured: it returned the instant the Syndication library's migration finished). So the
# app's first write is its own `photo library: ready` stage, one BULK seed (dated 2001, outside every capture
# window) through the rig, before the first contract.
#
# It FAILS on: any outcome that fails a run — `Failed(`, `Diverged(`, `NotWithin(` (`docs/architecture.md`,
# "Outcomes are explicit and none is silent") — any refusal (409: the process is not the simulator app, or it does
# not hold GRANTED), an empty registry, and an app that never publishes its rig port. Everything it learns goes to
# build/sim-contracts/, which CI keeps as an artifact: the outcome tables, and on a no-answer the screenshot and
# log, because a pending system alert is visible only in a screenshot.
#
# Then the ALL-REAL JOURNEYS (`docs/testing.md`, "All-real journeys are the contracts' safety net"):
# the same app, the real backend served locally on the address the `local` deployment bakes into the build
# (127.0.0.1:8080), and the journeys (`:test:integration`'s `journeys` source set, run by a bare JVM, not Gradle)
# driving the app through the typed client while playing the second member itself over the backend's public HTTP
# surface. Before any of that, the app's `GET /device` is read
# once: a vocabulary entry the host leaves unclassified fails the run. It FAILS on a backend that never answers, an
# incomplete advertisement, and any journey failure, printing the failing assertion.
#
# EVIDENCE, all in build/sim-contracts/: the stage timestamps (`stages`), load and memory sampled every 10 s
# (`resources.log`), the backend's output with a line per request, the app's log, and the host's and the
# simulator's crash reports from this run (`crash/`).
#
# Dev infrastructure: loads nothing on Linux. Runbook: the `ios-simulator` skill.
set -u

OUT=build/sim-contracts
mkdir -p "$OUT"
fail() { echo "sim-contracts: FAILED — $*" | tee -a "$OUT/result"; exit 1; }
# A timestamped marker per stage, kept with the evidence, so the job's wall-clock can be attributed.
stage() { echo "[$(date -u +%H:%M:%S)] $*" | tee -a "$OUT/stages"; }
# Crash reports newer than this marker are this run's.
touch "$OUT/.start"

# Load and memory, every 10 s for the whole run: a stall is then attributable to CPU or memory from the evidence.
(
    while :; do
        echo "=== $(date -u +%H:%M:%S) load $(sysctl -n vm.loadavg)"
        memory_pressure -Q 2>/dev/null | tail -1
        echo "swap $(sysctl -n vm.swapusage)"
        vm_stat | grep -E 'Pages free|Pageouts|Swapouts'
        sleep 10
    done
) > "$OUT/resources.log" 2>&1 &
SAMPLER_PID=$!
# Until the simulator exists and `cleanup` takes over, an early failure still stops the sampler.
trap 'kill "$SAMPLER_PID" 2>/dev/null' EXIT

grep -q '^snapsync.rig=true' "$HOME/.gradle/gradle.properties" 2>/dev/null \
    || fail "snapsync.rig=true is not in ~/.gradle/gradle.properties (never put it in the repo's)"

# applesimutils, pinned to a tap commit: the formula, and the bottle it pours, come from that commit, and auto-update is off
# so a newer formula cannot arrive mid-run.
APPLESIMUTILS_TAP_COMMIT=8f636f84541e08e850f455d7cffdfbd7ba305d3f   # applesimutils 0.9.12 (2025-06-18)
if ! command -v applesimutils >/dev/null; then
    export HOMEBREW_NO_AUTO_UPDATE=1 HOMEBREW_NO_INSTALL_CLEANUP=1
    # Cloned into the taps directory rather than `brew tap`ped: the tap also carries casks we never install,
    # and `brew tap` reads them all — its detox-instruments cask uses a deprecated `depends_on macos:` form,
    # which surfaced as a warning annotation on every run. Dropping `Casks/` before brew first looks keeps
    # the tap to the one formula we use.
    TAP_DIR="$(brew --repository)/Library/Taps/wix/homebrew-brew"
    [ -d "$TAP_DIR" ] || git clone -q https://github.com/wix/homebrew-brew "$TAP_DIR" || fail "could not clone wix/brew"
    git -C "$TAP_DIR" checkout -q "$APPLESIMUTILS_TAP_COMMIT" || fail "could not pin wix/brew"
    rm -rf "$TAP_DIR/Casks"
    brew install wix/brew/applesimutils >/dev/null || fail "could not install applesimutils"
fi

python3 scripts/resolve-deployment.py local >/dev/null || fail "could not render the local deployment"
# The Gradle build the xcodebuild runs RE-RENDERS the deployment at configuration time, from
# `snapsync.deployment` — `prod` by the repo's default. Without this the simulator app is baked for the SHARED
# production backend (measured: the journeys' first run POSTed a create there). A system property through
# GRADLE_OPTS reaches the Gradle that Xcode's build phase launches (an `ORG_GRADLE_PROJECT_` variable does not: its
# name cannot carry the dot, measured), and touches no gradle.properties on the machine. Everything below inherits it.
export GRADLE_OPTS="${GRADLE_OPTS:-} -Dorg.gradle.project.snapsync.deployment=local"

# The real backend, on the loopback address the `local` deployment bakes into the build. `dev:local` rather than
# `serve.ts --ephemeral`, which exits when its stdin closes and so cannot be backgrounded from a script. Its store is
# the runner's own, fresh per run. Started now and awaited after the build, so its first start (dependency
# downloads included) overlaps the xcodebuild; warmed with one request, because a cold deno exceeds the app's 5 s
# HTTP timeout.
command -v deno >/dev/null || fail "deno is not on PATH — the journeys need the real backend"
stage "backend: starting"
( cd api && deno task dev:local ) > "$OUT/backend.log" 2>&1 &
BACKEND_PID=$!
BACKEND="http://127.0.0.1:8080/api/v2"

DEVICE="$(xcrun simctl create "contracts-$$" 'iPhone 16')" || fail "could not create a simulator"
cleanup() {
    kill "${SAMPLER_PID:-}" "${FIXTURE_PID:-}" "${BACKEND_PID:-}" 2>/dev/null
    ./gradlew -q --stop >/dev/null 2>&1
    # This run's crash reports, host and simulator, before the simulator is deleted: a jetsam kill or a crash then
    # reads apart from a freeze.
    mkdir -p "$OUT/crash/host"
    find "$HOME/Library/Logs/DiagnosticReports" -type f -newer "$OUT/.start" -exec cp {} "$OUT/crash/host/" \; 2>/dev/null
    cp -R "$HOME/Library/Logs/CoreSimulator/$DEVICE" "$OUT/crash/simulator" 2>/dev/null
    xcrun simctl shutdown "$DEVICE" >/dev/null 2>&1; xcrun simctl delete "$DEVICE" >/dev/null 2>&1
}
trap cleanup EXIT

stage "xcodebuild: starting"
xcodebuild -project iosApp/iosApp.xcodeproj -scheme iosApp -configuration Debug -sdk iphonesimulator \
    -destination 'generic/platform=iOS Simulator' -derivedDataPath build/ios CODE_SIGNING_ALLOWED=NO build \
    > "$OUT/xcodebuild.log" 2>&1 || { tail -40 "$OUT/xcodebuild.log"; fail "xcodebuild"; }
stage "xcodebuild: done"
# The journeys compile now, on the daemon the xcodebuild's Gradle left running, so their run at the end compiles
# nothing. Then every Gradle and Kotlin daemon goes: they hold gigabytes the simulator would otherwise swap against.
./gradlew -q :test:integration:journeysClasses :test:integration:journeysClasspath > "$OUT/journeys-compile.log" 2>&1 \
    || { cat "$OUT/journeys-compile.log"; fail "the journeys did not compile"; }
./gradlew -q --stop >/dev/null 2>&1
pkill -f 'org.jetbrains.kotlin.daemon.KotlinCompileDaemon' 2>/dev/null
stage "journeys compiled, daemons stopped"
APP="$(find build/ios/Build/Products -maxdepth 2 -name '*.app' -path '*-iphonesimulator*' | head -1)"
[ -n "$APP" ] || fail "no simulator .app was built"
scripts/sim-sign "$APP" || fail "sim-sign"

i=0
until curl -s --max-time 5 -o /dev/null "$BACKEND/events/00000000-0000-4000-8000-000000000000"; do
    i=$((i + 1)); [ $i -lt 90 ] || { tail -40 "$OUT/backend.log"; fail "the local backend never answered on $BACKEND"; }; sleep 2
done
stage "backend: answering"

# Each simulator is this run's alone, and so is its port: every simulator shares the Mac's loopback, so a second
# instance on the default 18099 fails to bind while a curl reaches the FIRST one and answers plausibly.
free_port() { python3 -c 'import socket; s=socket.socket(); s.bind(("127.0.0.1", 0)); print(s.getsockname()[1])'; }
RIG_PORT="$(free_port)"
stage "simulator: booting"
xcrun simctl boot "$DEVICE" || fail "the simulator did not boot"
xcrun simctl bootstatus "$DEVICE" -b >/dev/null || fail "the simulator did not finish booting"
stage "simulator: booted"
# `apsd`, the simulator's push daemon, loops reconnecting to sandbox.push.apple.com from the runner: ~5 300 TCP+TLS
# attempts and 1.1 M log lines in six minutes, and serving that log cost `diagnosticd` ~170 s of CPU between boot and
# the app's first photo write (runs 36181223846, 36185184684). Nothing here needs it: the app has no APNs
# entitlement, and its registration fails before apsd is asked. Stopping it cut that CPU to 67–104 s (run
# 36188792139, three attempts). Never fatal: a simulator that keeps apsd is only slower.
{
    xcrun simctl spawn "$DEVICE" launchctl disable system/com.apple.apsd
    xcrun simctl spawn "$DEVICE" launchctl bootout system/com.apple.apsd
} > "$OUT/apsd-stop.log" 2>&1
# The app's first photo write waits until `assetsd` has built the library's compute cache and opened its search index
# (74 s of `validate` in run 36181223846; 1:23–4:43 per run before this). Opening Photos now, while the app installs,
# starts that preparation earlier: the first write then took 1–46 s (run 36188792139, three attempts). Photos stays
# open in the background; it never touches the app's state.
xcrun simctl launch "$DEVICE" com.apple.mobileslideshow > "$OUT/photos-warm.log" 2>&1
xcrun simctl install "$DEVICE" "$APP" || fail "install on $DEVICE"
stage "app: installed"
applesimutils --byId "$DEVICE" --bundle app.snapsync --setPermissions "photos=YES" >/dev/null \
    || fail "could not grant photo access on $DEVICE"
stage "app: granted"
# The loopback peer the transfer contracts exchange bytes with (scripts/transfer-fixture.py). Started BEFORE the app, and
# asked to answer, so a fixture that is not up fails here by name rather than as every transport clause's transfer error.
FIXTURE_PORT="$(free_port)"
python3 scripts/transfer-fixture.py --port "$FIXTURE_PORT" --log "$OUT/transfer-fixture.log" &
FIXTURE_PID=$!
i=0
until curl -sf --max-time 2 "http://127.0.0.1:$FIXTURE_PORT/_health" >/dev/null; do
    i=$((i + 1)); [ $i -lt 30 ] || fail "the transfer fixture never answered on $FIXTURE_PORT"; sleep 1
done
FIXTURE="http://127.0.0.1:$FIXTURE_PORT"

# Launch the app on simulator $1 with rig port $2, and wait for it to publish that port.
launch() {
    SIMCTL_CHILD_SNAPSYNC_RIG_PORT="$2" xcrun simctl launch "$1" app.snapsync >/dev/null || fail "launch on $1"
    data="$(xcrun simctl get_app_container "$1" app.snapsync data)"
    i=0
    while [ ! -f "$data/Documents/rig.port" ] && [ $i -lt 90 ]; do sleep 2; i=$((i + 1)); done
    if [ ! -f "$data/Documents/rig.port" ]; then
        xcrun simctl io "$1" screenshot "$OUT/no-answer-$1.png" >/dev/null 2>&1
        cp "$data/Documents/debug.log" "$OUT/debug-$1.log" 2>/dev/null
        fail "the app on $1 never published its rig port (screenshot and log in $OUT)"
    fi
    [ "$(cat "$data/Documents/rig.port")" = "$2" ] || fail "the app on $1 bound $(cat "$data/Documents/rig.port"), not $2"
}
launch "$DEVICE" "$RIG_PORT"
stage "app: launched"
DATA="$(xcrun simctl get_app_container "$DEVICE" app.snapsync data)"
PORT="$RIG_PORT"

# The app must be baked for the LOCAL backend. This is checked before anything drives it: a build pointed at the
# shared production backend would carry the journeys' traffic to real users' data.
base="$(curl -sS "http://127.0.0.1:$PORT/device/state" | python3 -c 'import json,sys; print(json.load(sys.stdin)["build"].get("uploadBase",""))')"
[ "$base" = "$BACKEND" ] || fail "the app is baked for '$base', not the local backend $BACKEND — refusing to run"

# The app host's classification of the control vocabulary, read once: nothing else checks the app host's
# advertisement for completeness, and an unclassified entry answers 500 only when someone asks.
code="$(curl -sS -o "$OUT/device.json" -w '%{http_code}' "http://127.0.0.1:$PORT/device")"
[ "$code" = 200 ] || { cat "$OUT/device.json"; fail "GET /device answered $code"; }
python3 - "$OUT/device.json" <<'PY' || fail "the app host leaves vocabulary entries unaccounted"
import json, sys
ad = json.load(open(sys.argv[1]))
gaps = ad.get("unclassified", []) + ad.get("outsideVocabulary", [])
print("advertisement:", ad.get("host"), len(ad.get("honoured", [])), "honoured,", len(ad.get("refused", {})), "refused")
sys.exit(1 if gaps else 0)
PY

# The photo library's first-use wait, as its own stage (see the header): the app's first write.
code="$(curl -sS -o "$OUT/readiness.json" -w '%{http_code}' -X POST "http://127.0.0.1:$PORT/device/gallery/seed?n=1&kind=bulk")"
[ "$code" = 200 ] || { cat "$OUT/readiness.json"; fail "the photo library never took its first write (HTTP $code)"; }
stage "photo library: ready"

stage "contracts: starting"
curl -sS --max-time 30 "http://127.0.0.1:$PORT/contract" > "$OUT/registry" || fail "GET /contract"
[ -s "$OUT/registry" ] || fail "the simulator app registers no contract"

status=0
for name in $(cat "$OUT/registry"); do
    code="$(curl -sS -o "$OUT/$name.txt" -w '%{http_code}' -X POST "http://127.0.0.1:$PORT/contract/$name?fixture=$FIXTURE")"
    echo "=== $name (HTTP $code)"
    cat "$OUT/$name.txt"
    if [ "$code" != 200 ]; then echo "  -> refused or missing"; status=1; fi
    if grep -q ' Failed(' "$OUT/$name.txt"; then echo "  -> a clause failed"; status=1; fi
    if grep -q ' Diverged(' "$OUT/$name.txt"; then echo "  -> a clause diverged"; status=1; fi
    # A bounded wait on an OS callback that expired ran nothing: on a host CI runs live, that is not coverage.
    if grep -q ' NotWithin(' "$OUT/$name.txt"; then echo "  -> a clause's callback never came"; status=1; fi
done
[ $status -eq 0 ] || { cp "$DATA/Documents/debug.log" "$OUT/debug.log" 2>/dev/null; fail "see the outcome tables above"; }
echo "sim-contracts: every registered contract passed" | tee "$OUT/result"

stage "journeys: starting"
# The journeys, against the app and the backend. A bare JVM on the classpath written at compile time, NOT Gradle: a
# Gradle daemon and a test JVM starting next to the live simulator pushed the runner into swap, and the app missed its
# 5 s HTTP timeout on a request the backend had answered in 132 ms (run 36173548419). A failure is read first as a
# contract clause nobody wrote.
"${JAVA_HOME:+$JAVA_HOME/bin/}java" -Xmx512m -cp "$(cat test/integration/build/journeys-classpath.txt)" \
    -Dsnapsync.journey.appA="http://127.0.0.1:$RIG_PORT" -Dsnapsync.journey.backend="$BACKEND" \
    org.junit.runner.JUnitCore app.snapsync.journeys.Journeys > "$OUT/journeys.log" 2>&1
journeys=$?
stage "journeys: done"
cp "$DATA/Documents/debug.log" "$OUT/debug.log" 2>/dev/null
if [ $journeys -ne 0 ]; then
    # JUnit's own failure section: the test, and the assertion's message, without the stack frames.
    sed -n '/^There w/,/^FAILURES/p' "$OUT/journeys.log" | grep -vE '^[[:space:]]+at ' | head -30
    fail "a journey failed (log in $OUT)"
fi
echo "sim-contracts: every registered contract passed, and the journeys passed" | tee "$OUT/result"

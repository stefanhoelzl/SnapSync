#!/bin/sh
# Run the simulator app's port contracts, end to end — the `ios-contracts` CI job, and its reproduction on a
# Mac session (capability `port-contracts`, "In-app hosts CI can reach are run live over the rig").
#
#   scripts/sim-contracts            # on macOS, from the repo root, with snapsync.rig=true in ~/.gradle
#
# It builds the rig app for the simulator, ad-hoc signs it (an unsigned build has no App Group), installs it on
# a FRESH simulator, grants photo access with applesimutils BEFORE the first launch (`simctl privacy grant
# photos` writes a TCC row PhotoKit never consults), launches it, and runs every contract `GET /contract` lists
# for this host. The contracts seed photos and never delete them, which is why the simulator is fresh.
#
# It FAILS on: any outcome that fails a run — `Failed(`, `Diverged(`, `NotWithin(` (capability `port-contracts`,
# "Outcomes are explicit and none is silent") — any refusal (409: the process is not the simulator app, or it does not
# hold GRANTED), an empty registry, and an app that never publishes its rig port. Everything it learns goes to
# build/sim-contracts/, which CI keeps as an artifact: the outcome tables, and on a no-answer the screenshot
# and log, because a pending system alert is visible only in a screenshot.
#
# Then the ALL-REAL JOURNEYS (capability `testing-architecture`, "All-real journeys are the contracts' safety net"):
# a second fresh simulator, the real backend served locally on the address the `local` deployment bakes into the
# build (127.0.0.1:8080), and `:test:integration:journeys` driving both apps through the typed client. Before any
# of that, each app's `GET /device` is read once: a vocabulary entry either host leaves unclassified fails the run.
# It FAILS on a backend that never answers, an incomplete advertisement, and any journey failure; the backend's
# output and both apps' logs go to build/sim-contracts/ with the rest.
#
# Dev infrastructure: loads nothing on Linux. Runbook: the `ios-simulator` skill.
set -u

OUT=build/sim-contracts
mkdir -p "$OUT"
fail() { echo "sim-contracts: FAILED — $*" | tee -a "$OUT/result"; exit 1; }
# A timestamped marker per stage, kept with the evidence, so the job's wall-clock can be attributed.
stage() { echo "[$(date -u +%H:%M:%S)] $*" | tee -a "$OUT/stages"; }

grep -q '^snapsync.rig=true' "$HOME/.gradle/gradle.properties" 2>/dev/null \
    || fail "snapsync.rig=true is not in ~/.gradle/gradle.properties (never put it in the repo's)"

# applesimutils, pinned to a tap commit: the formula, and the bottle it pours, come from that commit, and auto-update is off
# so a newer formula cannot arrive mid-run.
APPLESIMUTILS_TAP_COMMIT=8f636f84541e08e850f455d7cffdfbd7ba305d3f   # applesimutils 0.9.12 (2025-06-18)
if ! command -v applesimutils >/dev/null; then
    export HOMEBREW_NO_AUTO_UPDATE=1 HOMEBREW_NO_INSTALL_CLEANUP=1
    brew tap wix/brew >/dev/null || fail "could not tap wix/brew"
    git -C "$(brew --repo wix/brew)" checkout -q "$APPLESIMUTILS_TAP_COMMIT" || fail "could not pin wix/brew"
    brew install wix/brew/applesimutils >/dev/null || fail "could not install applesimutils"
fi

python3 scripts/resolve-deployment.py local >/dev/null || fail "could not render the local deployment"
# The Gradle build the xcodebuild runs RE-RENDERS the deployment at configuration time, from
# `snapsync.deployment` — `prod` by the repo's default. Without this the simulator app is baked for the SHARED
# production backend (measured: the journeys' first run POSTed a create there). A system property through
# GRADLE_OPTS reaches the Gradle that Xcode's build phase launches (an `ORG_GRADLE_PROJECT_` variable does not: its
# name cannot carry the dot, measured), and touches no gradle.properties on the machine. Everything below inherits it.
export GRADLE_OPTS="${GRADLE_OPTS:-} -Dorg.gradle.project.snapsync.deployment=local"

# The real backend, on the loopback address the `local` deployment bakes into the build. `dev:local` rather than
# `serve.ts --ephemeral`, which exits when its stdin closes and so cannot be backgrounded from a script. Its store is
# the runner's own, fresh per run. Started now and awaited after the build, so its first start (dependency
# downloads included) overlaps the xcodebuild; warmed with one request, because a cold deno exceeds the app's 5 s
# HTTP timeout.
command -v deno >/dev/null || fail "deno is not on PATH — the journeys need the real backend"
stage "backend: starting"
( cd api && deno task dev:local ) > "$OUT/backend.log" 2>&1 &
BACKEND_PID=$!
BACKEND="http://127.0.0.1:8080/api/v2"

# Both simulators are created and their boots STARTED before the build, so the boots overlap it rather than
# following it. A (the contracts, then journey member A) and B (journey member B).
DEVICE="$(xcrun simctl create "contracts-$$" 'iPhone 16')" || fail "could not create a simulator"
DEVICE_B="$(xcrun simctl create "journeys-b-$$" 'iPhone 16')" || fail "could not create the second simulator"
cleanup() {
    kill "${FIXTURE_PID:-}" "${BACKEND_PID:-}" "${BOOT_PID:-}" "${BOOT_PID_B:-}" 2>/dev/null
    for d in "$DEVICE" "$DEVICE_B"; do
        xcrun simctl shutdown "$d" >/dev/null 2>&1; xcrun simctl delete "$d" >/dev/null 2>&1
    done
}
trap cleanup EXIT
stage "simulators: booting"
xcrun simctl boot "$DEVICE" > "$OUT/boot-a.log" 2>&1 &
BOOT_PID=$!
xcrun simctl boot "$DEVICE_B" > "$OUT/boot-b.log" 2>&1 &
BOOT_PID_B=$!

stage "xcodebuild: starting"
xcodebuild -project iosApp/iosApp.xcodeproj -scheme iosApp -configuration Debug -sdk iphonesimulator \
    -destination 'generic/platform=iOS Simulator' -derivedDataPath build/ios CODE_SIGNING_ALLOWED=NO build \
    > "$OUT/xcodebuild.log" 2>&1 || { tail -40 "$OUT/xcodebuild.log"; fail "xcodebuild"; }
stage "xcodebuild: done"
APP="$(find build/ios/Build/Products -maxdepth 2 -name '*.app' -path '*-iphonesimulator*' | head -1)"
[ -n "$APP" ] || fail "no simulator .app was built"
scripts/sim-sign "$APP" || fail "sim-sign"

i=0
until curl -s --max-time 5 -o /dev/null "$BACKEND/events/00000000-0000-4000-8000-000000000000"; do
    i=$((i + 1)); [ $i -lt 90 ] || { tail -40 "$OUT/backend.log"; fail "the local backend never answered on $BACKEND"; }; sleep 2
done
stage "backend: answering"

# Each simulator is this run's alone, and so is its port: every simulator shares the Mac's loopback, so a second
# instance on the default 18099 fails to bind while a curl reaches the FIRST one and answers plausibly.
free_port() { python3 -c 'import socket; s=socket.socket(); s.bind(("127.0.0.1", 0)); print(s.getsockname()[1])'; }
RIG_PORT="$(free_port)"
RIG_PORT_B="$(free_port)"
wait "$BOOT_PID" || { cat "$OUT/boot-a.log"; fail "the simulator did not boot"; }
wait "$BOOT_PID_B" || { cat "$OUT/boot-b.log"; fail "the second simulator did not boot"; }
xcrun simctl bootstatus "$DEVICE" -b >/dev/null || fail "the simulator did not finish booting"
xcrun simctl bootstatus "$DEVICE_B" -b >/dev/null || fail "the second simulator did not finish booting"
stage "simulators: booted"
for d in "$DEVICE" "$DEVICE_B"; do
    xcrun simctl install "$d" "$APP" || fail "install on $d"
    applesimutils --byId "$d" --bundle app.snapsync --setPermissions "photos=YES" >/dev/null \
        || fail "could not grant photo access on $d"
done
# The loopback peer the transfer contracts exchange bytes with (scripts/transfer-fixture.py). Started BEFORE the app, and
# asked to answer, so a fixture that is not up fails here by name rather than as every transport clause's transfer error.
FIXTURE_PORT="$(free_port)"
python3 scripts/transfer-fixture.py --port "$FIXTURE_PORT" --log "$OUT/transfer-fixture.log" &
FIXTURE_PID=$!
i=0
until curl -sf --max-time 2 "http://127.0.0.1:$FIXTURE_PORT/_health" >/dev/null; do
    i=$((i + 1)); [ $i -lt 30 ] || fail "the transfer fixture never answered on $FIXTURE_PORT"; sleep 1
done
FIXTURE="http://127.0.0.1:$FIXTURE_PORT"

# Launch the app on simulator $1 with rig port $2, and wait for it to publish that port.
launch() {
    SIMCTL_CHILD_SNAPSYNC_RIG_PORT="$2" xcrun simctl launch "$1" app.snapsync >/dev/null || fail "launch on $1"
    data="$(xcrun simctl get_app_container "$1" app.snapsync data)"
    i=0
    while [ ! -f "$data/Documents/rig.port" ] && [ $i -lt 90 ]; do sleep 2; i=$((i + 1)); done
    if [ ! -f "$data/Documents/rig.port" ]; then
        xcrun simctl io "$1" screenshot "$OUT/no-answer-$1.png" >/dev/null 2>&1
        cp "$data/Documents/debug.log" "$OUT/debug-$1.log" 2>/dev/null
        fail "the app on $1 never published its rig port (screenshot and log in $OUT)"
    fi
    [ "$(cat "$data/Documents/rig.port")" = "$2" ] || fail "the app on $1 bound $(cat "$data/Documents/rig.port"), not $2"
}
stage "apps: installed and granted"
launch "$DEVICE" "$RIG_PORT"
launch "$DEVICE_B" "$RIG_PORT_B"
stage "apps: launched"
DATA="$(xcrun simctl get_app_container "$DEVICE" app.snapsync data)"
DATA_B="$(xcrun simctl get_app_container "$DEVICE_B" app.snapsync data)"
PORT="$RIG_PORT"

# Both apps must be baked for the LOCAL backend. This is checked before anything drives them: a build pointed at the
# shared production backend would carry the journeys' traffic to real users' data.
for p in "$RIG_PORT" "$RIG_PORT_B"; do
    base="$(curl -sS "http://127.0.0.1:$p/device/state" | python3 -c 'import json,sys; print(json.load(sys.stdin)["build"].get("uploadBase",""))')"
    [ "$base" = "$BACKEND" ] || fail "the app on $p is baked for '$base', not the local backend $BACKEND — refusing to run"
done

# Each app host's classification of the control vocabulary, read once: nothing else checks the app host's
# advertisement for completeness, and an unclassified entry answers 500 only when someone asks.
for p in "$RIG_PORT" "$RIG_PORT_B"; do
    code="$(curl -sS -o "$OUT/device-$p.json" -w '%{http_code}' "http://127.0.0.1:$p/device")"
    [ "$code" = 200 ] || { cat "$OUT/device-$p.json"; fail "GET /device on $p answered $code"; }
    python3 - "$OUT/device-$p.json" <<'PY' || fail "the app host on $p leaves vocabulary entries unaccounted"
import json, sys
ad = json.load(open(sys.argv[1]))
gaps = ad.get("unclassified", []) + ad.get("outsideVocabulary", [])
print("advertisement:", ad.get("host"), len(ad.get("honoured", [])), "honoured,", len(ad.get("refused", {})), "refused")
sys.exit(1 if gaps else 0)
PY
done

stage "contracts: starting"
curl -sS --max-time 30 "http://127.0.0.1:$PORT/contract" > "$OUT/registry" || fail "GET /contract"
[ -s "$OUT/registry" ] || fail "the simulator app registers no contract"

status=0
for name in $(cat "$OUT/registry"); do
    code="$(curl -sS -o "$OUT/$name.txt" -w '%{http_code}' -X POST "http://127.0.0.1:$PORT/contract/$name?fixture=$FIXTURE")"
    echo "=== $name (HTTP $code)"
    cat "$OUT/$name.txt"
    if [ "$code" != 200 ]; then echo "  -> refused or missing"; status=1; fi
    if grep -q ' Failed(' "$OUT/$name.txt"; then echo "  -> a clause failed"; status=1; fi
    if grep -q ' Diverged(' "$OUT/$name.txt"; then echo "  -> a clause diverged"; status=1; fi
    # A bounded wait on an OS callback that expired ran nothing: on a host CI runs live, that is not coverage.
    if grep -q ' NotWithin(' "$OUT/$name.txt"; then echo "  -> a clause's callback never came"; status=1; fi
done
[ $status -eq 0 ] || { cp "$DATA/Documents/debug.log" "$OUT/debug.log" 2>/dev/null; fail "see the outcome tables above"; }
echo "sim-contracts: every registered contract passed" | tee "$OUT/result"

stage "journeys: starting"
# The journeys, against both apps and the backend. A failure is read first as a contract clause nobody wrote.
./gradlew --no-daemon -q :test:integration:journeys \
    -Psnapsync.journey.appA="http://127.0.0.1:$RIG_PORT" \
    -Psnapsync.journey.appB="http://127.0.0.1:$RIG_PORT_B" \
    -Psnapsync.journey.backend="$BACKEND" > "$OUT/journeys.log" 2>&1
journeys=$?
stage "journeys: done"
cp -R test/integration/build/test-results/journeys "$OUT/journeys-results" 2>/dev/null
cp "$DATA/Documents/debug.log" "$OUT/debug.log" 2>/dev/null
cp "$DATA_B/Documents/debug.log" "$OUT/debug-b.log" 2>/dev/null
[ $journeys -eq 0 ] || { tail -60 "$OUT/journeys.log"; fail "a journey failed (log in $OUT)"; }
echo "sim-contracts: every registered contract passed, and the journeys passed" | tee "$OUT/result"

#!/bin/sh
# Hold the lease on the one physically-connected iPhone, for as long as this process lives.
#
# Dev infrastructure: non-gating, no spec. Enforced by scripts/device-guard (see .claude/settings.json).
#
#   ch-bg scripts/device-lease "<why you need the phone>"          # take it
#   ch-bg scripts/device-lease --steal "<why>"                     # take it from a live holder
#
# ALWAYS as a BACKGROUND Bash call, ALWAYS under ch-bg:
#   - background, because this blocks until killed — that IS the lease;
#   - ch-bg, because its marker excludes this shell from keeping the workspace busy, so the
#     workspace can still go idle while it holds the phone.
# The guard refuses both mistakes rather than letting you find out by hanging a turn.
#
# Release = kill this shell (it shows in the CodeHydra sidebar for exactly as long as the lease
# lasts). Session death releases it too. A SIGKILL cannot run the trap, so the guard also treats a
# lease whose pid is dead as reclaimable — liveness is checked, never a guessed timeout.
set -u

LOCK="${SNAPSYNC_DEVICE_LOCK:-$HOME/.snapsync-device.lock}"
PROBE_TIMEOUT=5

steal=0
if [ "${1:-}" = "--steal" ]; then steal=1; shift; fi
reason="${1:-}"

if [ -z "$reason" ]; then
  echo "usage: ch-bg scripts/device-lease [--steal] \"<why you need the phone>\"" >&2
  exit 2
fi

ws="${_CH_WORKSPACE_PATH:-$(pwd)}"
owned=0

cleanup() {
  st=$?
  # Only remove a lock we still own — never one that superseded ours.
  if [ "$owned" = 1 ] && [ -f "$LOCK" ] && [ "$(sed -n 's/^pid=//p' "$LOCK" | head -1)" = "$$" ]; then
    rm -f "$LOCK"
    echo "device-lease: released ($reason)"
  fi
  # Preserve the status we were called with: an `exit 0` here would mask the refusal paths,
  # and a refused acquire that reports success is exactly the silence this guard exists to end.
  trap - EXIT INT TERM HUP
  exit "$st"
}
trap cleanup EXIT INT TERM HUP

lock_get() { sed -n "s/^$1=//p" "$LOCK" | head -1; }

# --- 1. Is a phone actually connected? -------------------------------------------------------
# First act, deliberately: "no device connected" is a far better answer than a lease on nothing —
# and it is the state the operator has been announcing by hand ("device is connected") all along.
# usbmux list talks to usbmuxd on the host, not to the phone; it is outside the guard's fence.
if [ "${SNAPSYNC_DEVICE_SKIP_PROBE:-0}" != "1" ]; then
  probe=$(timeout "$PROBE_TIMEOUT" uvx --python 3.14 pymobiledevice3 usbmux list 2>&1) || probe=""
  case "$probe" in
    *Identifier* | *SerialNumber* | *UniqueDeviceID*) ;;
    *)
      echo "device-lease: no device connected — refusing to lease nothing." >&2
      echo "device-lease: usbmux list said: ${probe:-<no output / probe failed>}" >&2
      exit 1
      ;;
  esac
fi

# --- 2. Take the lock ------------------------------------------------------------------------
claim() {
  umask 077
  {
    echo "workspace=$ws"
    echo "pid=$$"
    echo "reason=$reason"
    echo "acquired=$(date +%s)"
    echo "acquired_human=$(date '+%Y-%m-%d %H:%M')"
  } > "$LOCK"
  owned=1
}

if [ -f "$LOCK" ]; then
  h_ws=$(lock_get workspace)
  h_pid=$(lock_get pid)
  h_reason=$(lock_get reason)
  if [ -n "$h_pid" ] && kill -0 "$h_pid" 2>/dev/null; then
    if [ "$steal" = 1 ]; then
      echo "device-lease: stealing from '$(basename "${h_ws:-unknown}")' (pid $h_pid — \"${h_reason:-none given}\")"
      kill "$h_pid" 2>/dev/null || true
      # Give its trap a moment to release; then take it regardless.
      i=0; while [ -f "$LOCK" ] && [ "$i" -lt 20 ]; do sleep 0.25; i=$((i + 1)); done
      rm -f "$LOCK"
    else
      echo "device-lease: held by '$(basename "${h_ws:-unknown}")' (pid $h_pid) — \"${h_reason:-none given}\"" >&2
      echo "device-lease: wait for it, or: ch-bg scripts/device-lease --steal \"<why>\"" >&2
      exit 1
    fi
  else
    echo "device-lease: reclaiming dead lease (pid ${h_pid:-?}, workspace ${h_ws:-?})"
    rm -f "$LOCK"
  fi
fi

claim
echo "device-lease: held by '$(basename "$ws")' (pid $$) — \"$reason\""
echo "device-lease: release by killing this shell."

# --- 3. Block. This process IS the lease. ----------------------------------------------------
# `sleep & wait` rather than a bare sleep, so a signal is handled immediately instead of after
# the current sleep completes.
while :; do
  sleep 3600 &
  wait $! 2>/dev/null || break
done

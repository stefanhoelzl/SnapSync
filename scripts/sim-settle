#!/bin/sh
# Settle a simulator once, so a cache can hand it to later runs already past its first-boot work — the `journeys (ios)`
# CI job's simulator cache (ci.yml), on a miss.
#
#   scripts/sim-settle <udid>
#
# A runner's first boot of the image's iPhone 17 spends minutes, at a load of 100-480 on 3 vCPUs, building what the
# device keeps in its own directory: the LaunchServices database, widget and wallpaper registrations, the Photos
# library and its caches (run 38393803729: boot 1.8 min, then 2.6 min to install the app under that load). This boots
# it, stops the daemons nothing tested needs (`scripts/lib/sim.sh` — `disable` persists, so a later boot never starts
# them), opens Photos so its library is created and migrated, waits for the load to fall, and shuts it down cleanly.
# No app is installed and no photo is added: the device stays as fresh as the image shipped it, only past its first
# boot.
set -u
DEVICE="${1:?usage: scripts/sim-settle <udid>}"
. scripts/lib/sim.sh
log() { echo "[$(date -u +%H:%M:%S)] sim-settle: $*"; }

log "booting $DEVICE"
xcrun simctl boot "$DEVICE" || { log "FAILED to boot"; exit 1; }
xcrun simctl bootstatus "$DEVICE" -b >/dev/null || { log "FAILED to finish booting"; exit 1; }
log "booted"
stop_daemons "$DEVICE"
xcrun simctl launch "$DEVICE" com.apple.mobileslideshow >/dev/null
# Settled: the 1-minute load under 4 for three samples in a row, 10 s apart — at most 10 min, after which it is saved
# as it is (a later boot finishes what is left).
calm=0; i=0
while [ $calm -lt 3 ] && [ $i -lt 60 ]; do
    sleep 10; i=$((i + 1))
    load="$(sysctl -n vm.loadavg | awk '{ print $2 }')"
    if awk -v l="$load" 'BEGIN { exit !(l < 4) }'; then calm=$((calm + 1)); else calm=0; fi
    [ $((i % 6)) -ne 0 ] || log "load $load"
done
log "settled after $((i * 10)) s (load $load)"
xcrun simctl terminate "$DEVICE" com.apple.mobileslideshow >/dev/null 2>&1
xcrun simctl shutdown "$DEVICE" || { log "FAILED to shut down"; exit 1; }
log "shut down; $(du -sh "$HOME/Library/Developer/CoreSimulator/Devices/$DEVICE" | cut -f1) to cache"

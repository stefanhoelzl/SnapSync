<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The backend, and on a rig build the control channel's loopback server. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      Whether the app has a network, and whether Android blocks it for this app (capability `sync-status`): read only
      while the app is in front, to tell the member. Granted at install; no prompt.
    -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      The member's photos (capability `photo-access`): full access is images AND video (API 33+), or storage (API
      30-32); API 34+ may grant only a selection. The location permission keeps each original's location in what is
      uploaded (MediaStore redacts it otherwise). Asked for together, only on a deliberate tap.
    -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />
    <uses-permission android:name="android.permission.ACCESS_MEDIA_LOCATION" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />

    <!--
      Other members' photos (capability `receiving-photos`) download through DownloadManager with no system notification:
      the app's own status line shows receiving, as on iPhone. Granted at install; no prompt.
    -->
    <uses-permission android:name="android.permission.DOWNLOAD_WITHOUT_NOTIFICATION" />

    <!--
      Nothing is backed up or transferred to another device: see res/xml/data_extraction_rules.xml. The per-app
      language list (localeConfig) exists from API 33 and is ignored below it, hence tools:targetApi.
    -->
    <application
        android:name=".SnapSyncApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.SnapSync"
        tools:targetApi="33">
        <!-- singleTop: an event link opened while the app runs reaches the running activity (onNewIntent). -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!--
              The event link (capability `join-event`): https://<the resolved deployment's domain>/join, exactly (the
              fragment form), and /join/<eventId> (the path form) — the same narrow claim the AASA makes, so the
              marketing page and the device API keep opening in a browser. autoVerify asks Android to check the domain's /.well-known/assetlinks.json; until that names
              this app's signing certificate (phase 5), the link is unverified and opens in the browser.
            -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <!-- One attribute per tag: Android merges every <data> of a filter into one scheme × host × path match. -->
                <data android:scheme="https" />
                <data android:host="${linkHost}" />
                <data android:path="/join" />
                <data android:pathPrefix="/join/" />
            </intent-filter>
        </activity>
        <!--
          The silent wake (capability `receiving-photos`): FCM's entry into the app. Not exported: only FCM, through
          Google Play services, delivers to it.
        -->
        <service
            android:name="app.snapsync.android.push.SnapSyncMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <!--
          Firebase starts only by hand, from the resolved deployment's values (`AndroidPushNotifications`): its auto-start
          provider would look for a google-services.json this build does not carry, and would start Firebase in a rig
          launch whose push service is mocked.
        -->
        <provider
            android:name="com.google.firebase.provider.FirebaseInitProvider"
            android:authorities="${applicationId}.firebaseinitprovider"
            tools:ignore="MissingClass"
            tools:node="remove" />
        <!--
          DownloadManager's completion broadcast (capability `receiving-photos`): declared here so it reaches a dead
          process. Exported because the download provider sends it; only a sender holding its permission can.
        -->
        <receiver
            android:name="app.snapsync.android.download.DownloadCompleteReceiver"
            android:exported="true"
            android:permission="android.permission.SEND_DOWNLOAD_COMPLETED_INTENTS">
            <intent-filter>
                <action android:name="android.intent.action.DOWNLOAD_COMPLETE" />
            </intent-filter>
        </receiver>
    </application>
</manifest>

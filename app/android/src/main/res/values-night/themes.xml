<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The dark window: light bar icons on the dark theme (see values/themes.xml). -->
    <style name="Theme.SnapSync" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <!-- The screen's background (AppTheme's background colour), so the window the OS shows before the first frame
             already matches the screen that replaces it. The bars carry no colour of their own: enableEdgeToEdge makes
             them transparent, and their colour attributes are deprecated from Android 15 (Google Play flags them). -->
        <item name="android:windowBackground">@color/screen_background</item>
    </style>
</resources>

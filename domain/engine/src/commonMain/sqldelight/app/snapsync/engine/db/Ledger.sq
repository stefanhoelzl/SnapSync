import app.snapsync.engine.LedgerState;
import kotlin.time.Instant;

CREATE TABLE ledgerRow (
    key TEXT NOT NULL PRIMARY KEY,
    assetId TEXT NOT NULL,
    state TEXT AS LedgerState NOT NULL,
    attempt INTEGER NOT NULL,
    updatedAt INTEGER AS Instant NOT NULL
);

CREATE INDEX ledgerRow_assetId ON ledgerRow(assetId);

get:
SELECT key, assetId, state, attempt, updatedAt
FROM ledgerRow
WHERE key = :key;

put:
INSERT OR REPLACE INTO ledgerRow (key, assetId, state, attempt, updatedAt)
VALUES (:key, :assetId, :state, :attempt, :updatedAt);

deleteAll:
DELETE FROM ledgerRow;

-- Prune one asset's rows by equality (rides the assetId index). Used for the incremental
-- deletion path and, per-straggler, by retainAssets.
deleteByAssetId:
DELETE FROM ledgerRow
WHERE assetId = :assetId;

-- The distinct assets currently present — read by retainAssets to compute the complement in
-- Kotlin (so an arbitrarily large keep-set is never bound into one statement).
selectAllAssetIds:
SELECT DISTINCT assetId FROM ledgerRow;

-- The non-COMPLETED rows (the backlog) as (assetId, key) pairs. The status overlay groups these by
-- photo in Kotlin to intersect outstanding resources with observed completions, without
-- materializing the (large, static) completed set. Shrinks as sync drains.
selectPending:
SELECT assetId, key FROM ledgerRow
WHERE state != 'COMPLETED';

-- Aggregates counted by PHOTO (assetId), not resource row: collapse rows to assets first, then
-- count. A photo is complete only when none of its rows is non-COMPLETED.
aggregates:
WITH perAsset AS (
    SELECT assetId,
           SUM(CASE WHEN state != 'COMPLETED' THEN 1 ELSE 0 END) AS notDone,
           MAX(updatedAt) AS lastTouch
    FROM ledgerRow
    GROUP BY assetId
)
SELECT
    COUNT(CASE WHEN notDone > 0 THEN 1 END) AS pending,
    COUNT(CASE WHEN notDone = 0 THEN 1 END) AS completed,
    MAX(CASE WHEN notDone = 0 THEN lastTouch END) AS newestCompletionAt
FROM perAsset;

import app.snapsync.model.AssetId;
import app.snapsync.model.DownloadState;

-- v6 -> v7: which event a received photo belongs to is a row of its own, and a planned resource names its event
-- (change `event-scoped-local-state`).
--
-- `downloadAsset` stays the per-photo record — keyed by the SOURCE photo, so "never received twice" and the import
-- marker that keeps a received photo from being shared back hold across events — but its `eventId` tag goes. That tag
-- named the union a row was LAST seen in and was rewritten by every reconcile, so a photo two events share counted
-- for one of them only. `eventRef` holds one row per (event, photo) instead, and the received count and the album
-- gather read it.
--
-- `downloadResource.eventId` is the event whose folder a planned resource's bytes are fetched from: each event holds
-- its own bytes (change `per-event-storage-layout`). A row planned before this migration takes its asset's tag, or
-- the empty event when it had none; it downloads and imports exactly as before.
--
-- ROW-PRESERVING: no asset or resource row is deleted, and no state or marker changes. Staged paths are stored, not
-- composed, so no staged file moves.
--
-- REBUILT, not `ALTER TABLE … DROP COLUMN`: that needs SQLite 3.35, and Android 11 ships 3.28 (12 and 13: 3.32). As a
-- `DROP COLUMN` this migration — which every fresh install runs, the schema being derived from the chain — failed
-- there and left downloads.db unopenable (SNAPSYNC-59/60). Edited after it shipped, against `MigrationPinTest`'s rule,
-- because no later migration can fix a statement a fresh install runs first; the table it leaves is the one the
-- `DROP COLUMN` left, so a device that already ran it holds the same schema. The rows are staged in an ordinary
-- table, the table is re-created without the column, the rows come back, and its one index is re-created.
CREATE TABLE eventRef (
    eventId        TEXT NOT NULL,
    sourceDeviceId TEXT NOT NULL,
    sourceAssetId  TEXT NOT NULL,
    PRIMARY KEY (eventId, sourceDeviceId, sourceAssetId)
);

INSERT INTO eventRef (eventId, sourceDeviceId, sourceAssetId)
SELECT eventId, sourceDeviceId, sourceAssetId FROM downloadAsset WHERE eventId IS NOT NULL;

ALTER TABLE downloadResource ADD COLUMN eventId TEXT NOT NULL DEFAULT '';

UPDATE downloadResource
SET eventId = (
    SELECT a.eventId FROM downloadAsset a
    WHERE a.sourceDeviceId = downloadResource.sourceDeviceId AND a.sourceAssetId = downloadResource.sourceAssetId
)
WHERE EXISTS (
    SELECT 1 FROM downloadAsset a
    WHERE a.sourceDeviceId = downloadResource.sourceDeviceId AND a.sourceAssetId = downloadResource.sourceAssetId
      AND a.eventId IS NOT NULL
);

CREATE TABLE downloadAsset_v7 AS
SELECT sourceDeviceId, sourceAssetId, state, creationDate, createdLocalId FROM downloadAsset;

DROP INDEX downloadAsset_createdLocalId;
DROP TABLE downloadAsset;

CREATE TABLE downloadAsset (
    sourceDeviceId TEXT NOT NULL,
    sourceAssetId  TEXT AS AssetId NOT NULL,
    state          TEXT AS DownloadState NOT NULL,
    creationDate   TEXT NOT NULL,
    createdLocalId TEXT AS AssetId,
    PRIMARY KEY (sourceDeviceId, sourceAssetId)
);

INSERT INTO downloadAsset (sourceDeviceId, sourceAssetId, state, creationDate, createdLocalId)
SELECT sourceDeviceId, sourceAssetId, state, creationDate, createdLocalId FROM downloadAsset_v7;

DROP TABLE downloadAsset_v7;

CREATE INDEX downloadAsset_createdLocalId ON downloadAsset(createdLocalId);

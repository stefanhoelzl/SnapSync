-- v5 -> v6: the position each event's union was last read to (decision record `changes/incremental-union`, D6), so
-- a push or a background wake reads only what the union gained since. Written in the SAME transaction as the plan of
-- the assets that read served, so it can never stand past an asset that was not planned. No row: no position — the
-- next read is a full one.
CREATE TABLE unionCursor (
    eventId TEXT NOT NULL PRIMARY KEY,
    cursor  INTEGER NOT NULL
);

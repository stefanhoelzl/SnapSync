---
// The event page (capabilities join-event, event-site), served at /join (a fragment invite) and /join/<eventId>
// (the event's own page). Built ONCE by the site/ module as a TEMPLATE: every %%TOKEN%% below is filled per
// request by the api (`api/src/routes/event-page.ts` decides every word; `site.ts` serves it), so a link preview
// and a browser running no script both see the event — its name, dates, phase and members. The tokens are the
// contract between the two; `data-view` picks the one view the CSS shows.
//
// - `event`   — /join/<eventId>: the server rendered the event. The island adds the photo count and the zip.
// - `invalid` — an unknown, malformed or completed event: the server says so, and names no event.
// - `pending` — /join, a fragment invite: the server cannot see which event (the fragment is never sent), so
//               the island reads it and moves the browser to /join/<eventId>.
//
// SELF-CONTAINED (web-site invariant + web-event-download Decision 5): every subresource is same-origin
// (the island — including the bundled `fflate` zip library — compiles to _astro/*), and the ONLY
// off-origin fetches are the presigned photo URLs — data, not code. `fflate` is BUNDLED (not CDN-loaded),
// which is what keeps it same-origin; it STORE-zips (level 0) since photos are already compressed, and
// handles CRC + ZIP64 so a >4 GB event does not corrupt the archive.
import Layout from "../layouts/Layout.astro";
import AppStoreButton from "../components/AppStoreButton.astro";
import PlayOffer from "../components/PlayOffer.astro";
---

<Layout title="%%TITLE%%" ogTitle="%%OG_TITLE%%" description="%%DESCRIPTION%%" ogUrl="%%URL%%">
  <div class="join" id="join" data-view="%%VIEW%%">
    <div id="app">
      <div class="pillrow">%%PILL%%</div>
      <h1 id="title">%%HEADING%%</h1>
      <div class="facts">%%FACTS%%</div>
      <p class="sub" id="subtitle">
        Join with SnapSync, and every photo arrives in your gallery. Or download them all here.
      </p>
      <button class="primary" id="download" disabled>
        Download all photos (zip)
      </button>
      <div class="status" id="status">
        Loading…
      </div>
      <div class="cta">
        <AppStoreButton />
        <PlayOffer />
      </div>
    </div>
    <div id="invalid">
      <h1>Invalid or expired link</h1>
      <p class="sub">
        This link could not be opened. If the event is still on, ask anyone in it for a new link.
      </p>
      <div class="cta">
        <AppStoreButton />
        <PlayOffer />
      </div>
    </div>
  </div>
</Layout>

<style is:global>
  /* @property must be global (custom-property registration is document-scoped). It drives the download
     button's progress fill. */
  @property --p {
    syntax: "<percentage>";
    inherits: false;
    initial-value: 0%;
  }
  .join {
    max-width: 420px;
    margin: 8vh auto;
    padding: 0 24px;
    text-align: center;
  }
  .join h1 {
    font-size: 1.6rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin: 0 0 8px;
  }
  .join p.sub {
    margin: 0 0 28px;
    color: var(--muted);
    font-size: 1rem;
  }
  /* The primary action carries the SnapSync green AND doubles as the download progress bar: a translucent
     fill sweeps left→right to --p while a download runs. */
  .join button.primary {
    appearance: none;
    border: 0;
    border-radius: 13px;
    padding: 15px 22px;
    width: 100%;
    font-size: 1.05rem;
    font-weight: 600;
    color: #fff;
    --p: 0%;
    background:
      linear-gradient(90deg, rgba(255, 255, 255, 0.28) var(--p), rgba(255, 255, 255, 0) var(--p)),
      linear-gradient(180deg, var(--green-2), var(--green));
    box-shadow: var(--shadow);
    cursor: pointer;
    transition:
      transform 0.15s ease,
      --p 0.2s ease;
  }
  .join button.primary:hover:not(:disabled) {
    transform: translateY(-2px);
  }
  .join button.primary:disabled {
    opacity: 0.5;
    cursor: default;
  }
  .join button.primary.busy {
    opacity: 1;
  }
  .join .status {
    margin-top: 16px;
    min-height: 1.2em;
    font-size: 0.95rem;
    color: var(--muted);
  }
  .join .cta {
    margin-top: 28px;
  }
  /* Exactly one view shows, chosen by the server's data-view (the island may switch it): no script needed. */
  .join[data-view="event"] #invalid,
  .join[data-view="invalid"] #app,
  .join[data-view="pending"] #app,
  .join[data-view="pending"] #invalid {
    display: none;
  }
  /* The server-rendered facts (event-page.ts), as in the approved mockup. */
  .join .pillrow {
    min-height: 0;
  }
  .join .pill {
    display: inline-block;
    padding: 2px 12px;
    border-radius: 999px;
    font-size: 0.8rem;
    font-weight: 600;
    margin-bottom: 12px;
  }
  .join .pill.running {
    background: color-mix(in srgb, var(--green) 14%, transparent);
    color: var(--green);
  }
  .join .pill.running::before {
    content: "● ";
  }
  .join .pill.upcoming {
    background: var(--surface-2);
    color: var(--muted);
  }
  .join .pill.ended {
    background: color-mix(in srgb, #d68c00 16%, transparent);
    color: #a86b00;
  }
  @media (prefers-color-scheme: dark) {
    .join .pill.ended {
      color: #f0b44c;
    }
  }
  .join .facts {
    margin: 0 0 20px;
    color: var(--muted);
    font-size: 0.95rem;
  }
  .join .facts p {
    margin: 2px 0;
  }
  .join .facts .dates {
    color: var(--text);
    font-weight: 600;
  }
  .join .dots {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 5px;
    margin: 8px 0 4px;
  }
  .join .dot {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    border: 2px solid var(--green);
  }
  .join .dot.done {
    background: var(--green);
  }
</style>

<script>
  import { zipSync } from "fflate";
  import { decodeInvite, eventIdFromPath, inviteFor, playHrefFor } from "../lib/invite";
  import { withDownloadUrls, zipEntries } from "../lib/zip-names";
  import { decryptFile, fileAssociatedData, keyFromFragment, opens } from "../lib/event-key";

  (function () {
    const $ = (id: string) => document.getElementById(id)!;
    const setView = (view: "event" | "invalid") => {
      $("join").dataset.view = view;
    };
    const setStatus = (t: string) => {
      $("status").textContent = t;
    };

    async function main() {
      const view = $("join").dataset.view;

      // A fragment invite (`/join#v=3&d=…`, capability `join-event`): the server could not see which event, so
      // move to the event's own page, which it renders. `replace` keeps the fragment page out of history.
      if (view === "pending") {
        const invite = decodeInvite(location.hash);
        if (invite) location.replace("/join/" + invite.eventId);
        else setView("invalid");
        return;
      }
      // The invalid view's Google Play badge stays a plain link, handing Google nothing (privacy-security).
      if (view !== "event") return;

      const eventId = eventIdFromPath(location.pathname);
      if (!eventId) {
        setView("invalid");
        return;
      }
      // The event view's Google Play badge carries the invite as the install referrer, so an Android install from it
      // opens the invite on first launch (capabilities join-event, privacy-security) — the same `v=3&d=` referrer the
      // fragment form carried.
      const play = document.querySelector<HTMLAnchorElement>("#app a[data-play-store]");
      if (play) play.href = playHrefFor(play.dataset.playStore!, inviteFor(eventId));

      // The name, dates and members are the server's; the island adds only the photo list — same-origin, an
      // un-attested read on the canonical versioned prefix.
      const name = $("title").textContent?.trim() || undefined;
      // An ENCRYPTED event's photos open only with the key its whole invite carries in `#k=` (the encrypted file
      // format, `docs/architecture.md`) — read here, never sent anywhere, checked against the key id the event names
      // before a single photo is fetched.
      let key: Uint8Array | null = null;
      try {
        const metaRes = await fetch("/api/v1/events/" + eventId);
        if (metaRes.ok) {
          const keyId = (await metaRes.json()).keyId;
          if (typeof keyId === "string") {
            key = keyFromFragment(location.hash);
            if (key === null || !(await opens(key, keyId))) {
              setStatus(
                "This event's photos are encrypted. Open the whole invite link, or scan the event's QR code, to download them.",
              );
              return;
            }
          }
        }
      } catch (_e) {
        setStatus("Couldn't load this event. Check your connection and reload.");
        return;
      }

      let union: any[];
      try {
        // Without urls: each file is addressed at its download route, which redirects to the bytes
        // (decision record `changes/incremental-union`, D8).
        const unionRes = await fetch("/api/v1/events/" + eventId + "/files?urls=false");
        if (unionRes.status === 404) {
          setView("invalid");
          return;
        }
        if (!unionRes.ok) throw new Error("union " + unionRes.status);
        union = withDownloadUrls("/api/v1", eventId, await unionRes.json());
      } catch (_e) {
        setStatus("Couldn't load this event. Check your connection and reload.");
        return;
      }

      // Every photo's original, and a Live Photo's video beside its still under the same name
      // (capability `event-site`; the naming rule is `zip-names.ts`).
      const { entries: items, photos } = zipEntries(union);
      if (items.length === 0) {
        setStatus("No photos have been shared to this event yet.");
        return;
      }

      setStatus(photos + " photo" + (photos === 1 ? "" : "s") + " ready.");
      const btn = $("download") as HTMLButtonElement;
      const LABEL = "Download all photos (zip)";
      const setP = (frac: number) => btn.style.setProperty("--p", Math.round(frac * 100) + "%");
      btn.disabled = false;
      btn.addEventListener("click", async () => {
        btn.disabled = true;
        btn.classList.add("busy");
        setP(0);
        const files: Record<string, Uint8Array> = {};
        try {
          for (let i = 0; i < items.length; i++) {
            btn.textContent = "Downloading file " + (i + 1) + " of " + items.length + "…";
            setP(i / items.length);
            const res = await fetch(items[i].url);
            if (!res.ok) throw new Error("photo " + res.status);
            const bytes = new Uint8Array(await res.arrayBuffer());
            const item = items[i];
            files[item.name] = key
              ? await decryptFile(
                  bytes,
                  key,
                  fileAssociatedData(eventId, item.deviceId, item.assetId, item.role),
                )
              : bytes;
            setP((i + 1) / items.length);
          }
          btn.textContent = "Building zip…";
          setP(1);
          // STORE (level 0) — photos are already compressed; fflate handles CRC + ZIP64 for large events.
          const zip = zipSync(files, { level: 0 });
          const url = URL.createObjectURL(new Blob([zip as BlobPart], { type: "application/zip" }));
          const a = document.createElement("a");
          a.href = url;
          a.download = (name || "snapsync").replace(/[^\w.-]+/g, "-") + ".zip";
          document.body.appendChild(a);
          a.click();
          a.remove();
          setTimeout(() => URL.revokeObjectURL(url), 60000);
          setStatus("Done — " + photos + " photo" + (photos === 1 ? "" : "s") + " downloaded.");
        } catch (_e) {
          setStatus(
            "Download failed. Reload and try again" +
              (Object.keys(files).length
                ? " (a very large event may exceed this browser's memory)."
                : "."),
          );
        } finally {
          btn.disabled = false;
          btn.classList.remove("busy");
          setP(0);
          btn.textContent = LABEL;
        }
      });
    }

    main();
  })();
</script>

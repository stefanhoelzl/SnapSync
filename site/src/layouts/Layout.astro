---
// Shared page shell for the whole site (capability web-site): the sticky header (brand + nav), the
// <main> slot, and the footer. Both the landing page and the /join download page compose from this one
// layout so they can never drift in brand, theme, or chrome. Nav links point at the landing's sections
// (/#…) so they work from either page. Zero off-origin subresources — the web-site self-containment
// invariant applies to everything defined here.
//
// EVERY off-site link on this site opens in a new tab (target=_blank + rel="noopener noreferrer") and
// says so in its accessible name. The rule is uniform on purpose: the load-bearing case is the App Store
// CTA on /join, where navigating away would discard the island's in-flight zip — a rule applied to only
// the one link that needs it is the rule that rots.
import "../styles/theme.css";
import { getImage } from "astro:assets";
import appIcon from "../../../iosApp/iosApp/Assets.xcassets/AppIcon.appiconset/Icon-1024.png";

interface Props {
  title: string;
  description?: string;
  ogUrl?: string;
}
const {
  title,
  description = "Share the photos from an event — every photo the group takes lands in everyone's library.",
  ogUrl = "https://snapsync.stho.net/",
} = Astro.props;

// The real app icon, emitted same-origin (astro:assets → _astro/…, so the web-site self-containment
// invariant holds). Two derived sizes from the one committed source of truth (Icon-1024.png): a 192px
// webp drives the on-page .brandmark (rendered ≤96px, so 2× for retina) via the --appicon CSS var set on
// <body>; a 64px png is the browser-tab favicon (a raster tab icon is wanted, and png is accepted where
// a webp favicon is not). The port had replaced the brandmark with a flat green gradient and dropped the
// favicon entirely — this restores both.
const brandmark = await getImage({ src: appIcon, width: 192, height: 192, format: "webp" });
const favicon = await getImage({ src: appIcon, width: 64, height: 64, format: "png" });
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href={favicon.src} />
    <meta name="theme-color" content="#0E9D6B" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0C0E12" media="(prefers-color-scheme: dark)" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={ogUrl} />
  </head>
  <body style={`--appicon:url(${brandmark.src})`}>
    <header>
      <div class="wrap">
        <a class="brand" href="/"><span class="brandmark sm"></span>SnapSync</a>
        <nav>
          <a class="hide-sm" href="/#how">How it works</a>
          <a class="hide-sm" href="/#privacy">Privacy</a>
          <a class="hide-sm" href="/#terms">Terms</a>
          <a
            href="https://github.com/stefanhoelzl/SnapSync/issues"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Support (opens in a new tab)">Support</a
          >
        </nav>
      </div>
    </header>

    <main><slot /></main>

    <footer>
      <div class="wrap">
        <a class="brand" href="/" style="font-size:1rem"
          ><span class="brandmark xs"></span>SnapSync</a
        >
        <div class="flinks">
          <a href="/#how">How it works</a>
          <a href="/#privacy">Privacy</a>
          <a href="/#terms">Terms</a>
          <a
            href="https://github.com/stefanhoelzl/SnapSync/issues"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Support (opens in a new tab)">Support</a
          >
          <a
            href="mailto:stefanh+snapsync@posteo.de"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Contact (opens in a new tab)">Contact</a
          >
        </div>
        <p class="copy">
          © 2026 SnapSync · An independent project · Not affiliated with Apple Inc. "App Store" is a
          trademark of Apple Inc.
        </p>
      </div>
    </footer>
  </body>
</html>

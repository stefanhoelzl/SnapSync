<?xml version="1.0" encoding="utf-8"?>
<!-- Only the selection permission: a device-test APK is installed with every declared runtime permission granted, so
     this APK starts, and stays, under a partial grant — the selection it saves itself. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />
</manifest>

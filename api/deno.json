{
  "name": "@snapsync/api",
  "version": "0.1.0",
  "exports": "./src/main.ts",
  "tasks": {
    // --allow-read/--allow-write are for the dev filesystem shim's contract test, which writes into a
    // temp dir. --allow-net stays ABSENT on purpose: that is the flag whose absence guarantees no test
    // can reach the real bunny zone (a network call fails as a permission error, not a live request).
    "test": "deno test --allow-read --allow-write",
    "check": "deno check src/*.ts src/dev/*.ts",
    // The local backend rig (dev infrastructure — non-gating, no spec). `dev:local` is the curl loop;
    // `dev:tunnel` adds a cloudflared quick tunnel so a physical device can reach it under default ATS.
    // Neither is reachable from the deployed bundle, which `deno bundle` roots at src/main.ts.
    "dev:local": "deno run --allow-net --allow-read --allow-write --allow-run src/dev/serve.ts",
    "dev:tunnel": "deno run --allow-net --allow-read --allow-write --allow-run src/dev/serve.ts --tunnel",
    "bundle": "deno bundle src/main.ts -o dist/main.js",
    "lint": "deno lint",
    "fmt": "deno fmt"
  },
  "imports": {
    "@bunny.net/edgescript-sdk": "npm:@bunny.net/edgescript-sdk@^0.12.1",
    "hono": "npm:hono@^4.12",
    "aws4fetch": "npm:aws4fetch@^1",
    "jose": "npm:jose@^5",
    "@std/assert": "jsr:@std/assert@^1",
    "@std/encoding": "jsr:@std/encoding@^1",
    "@std/path": "jsr:@std/path@^1",
    "@levischuck/tiny-cbor": "jsr:@levischuck/tiny-cbor@^0.2",
    "@peculiar/x509": "npm:@peculiar/x509@^1.12"
  },
  "fmt": {
    "lineWidth": 100
  },
  "lint": {}
}

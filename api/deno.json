{
  "name": "@snapsync/api",
  "version": "0.1.0",
  "exports": "./src/main.ts",
  "tasks": {
    // Every task RESOLVES A DEPLOYMENT first, naming it explicitly — there is no default, and an unknown
    // name fails closed. The renderings are generated, never committed, so a task that skipped this would
    // hit a missing module rather than a stale value. The resolver is a SEPARATE process, so chaining it
    // cannot widen the permissions the suite below runs under.
    "config": "python3 ../scripts/resolve-deployment.py prod --quiet",
    "config:local": "python3 ../scripts/resolve-deployment.py local --quiet",
    // The MAINTENANCE deployment (capability `backend-deployment`): identical to `prod` in every value
    // but the window flag, because both extend the same component. `api-deploy.yml` publishes this
    // bundle, migrates, then republishes the `prod` one.
    "config:maintenance": "python3 ../scripts/resolve-deployment.py maintenance --quiet",
    // --allow-read/--allow-write are for the dev filesystem shim's contract test, which writes into a
    // temp dir. --allow-net stays ABSENT on purpose: that is the flag whose absence guarantees no test
    // can reach the real bunny zone (a network call fails as a permission error, not a live request).
    "test": "deno task config && deno test --allow-read --allow-write",
    // src/scripts/ holds the out-of-bundle programs other workflows invoke (the sweep, the deploy probe).
    // They are type-checked here for the same reason src/dev/ is: a broken one must fail CI rather than
    // surface the next time someone runs it.
    "check": "deno task config && deno check src/*.ts src/dev/*.ts src/scripts/*.ts",
    // The local backend rig (dev infrastructure — non-gating, no spec). `dev:local` is the curl loop;
    // `dev:tunnel` adds a cloudflared quick tunnel so a physical device can reach it under default ATS.
    // Both resolve the `local` deployment, whose filesystem storage kind the rig requires — running them
    // against a bunny deployment throws rather than writing into a real zone.
    "dev:local": "deno task config:local && deno run --allow-net --allow-read --allow-write --allow-run src/dev/serve.ts",
    "dev:tunnel": "deno task config:local && deno run --allow-net --allow-read --allow-write --allow-run src/dev/serve.ts --tunnel",
    "bundle": "deno task config && deno bundle src/main.ts -o dist/main.js",
    "bundle:maintenance": "deno task config:maintenance && deno bundle src/main.ts -o dist/main.js",
    "lint": "deno lint",
    "fmt": "deno fmt"
  },
  "imports": {
    "@bunny.net/edgescript-sdk": "npm:@bunny.net/edgescript-sdk@^0.12.1",
    "@libsql/client/web": "npm:@libsql/client@^0.15/web",
    "hono": "npm:hono@^4.12",
    "aws4fetch": "npm:aws4fetch@^1",
    "jose": "npm:jose@^5",
    "@std/assert": "jsr:@std/assert@^1",
    "@std/encoding": "jsr:@std/encoding@^1",
    "@std/path": "jsr:@std/path@^1",
    "@levischuck/tiny-cbor": "jsr:@levischuck/tiny-cbor@^0.2",
    "@peculiar/x509": "npm:@peculiar/x509@^1.12"
  },
  "fmt": {
    "lineWidth": 100
  },
  "lint": {}
}

<?xml version="1.0" encoding="utf-8"?>
<!-- The CrashReporter contract's loopback ingest is plain HTTP inside the test process. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <application android:usesCleartextTraffic="true">
        <!--
          The process-death clause's app process (`SentryProcessDeathContractTest`): it starts the channel and dies on an
          InvalidProgramState, in a process of its own, so the test process is the next launch.
        -->
        <service
            android:name="app.snapsync.sentry.ContractDeathService"
            android:exported="false"
            android:process=":contractdeath" />
    </application>
</manifest>

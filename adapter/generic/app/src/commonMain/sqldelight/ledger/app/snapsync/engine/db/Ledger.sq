import app.snapsync.model.LedgerState;

-- `eventId` is provenance, not dedup state: the event that was joined when the row was recorded.
-- `DEFAULT ''` must match 4.sqm exactly (the verify task compares migrated vs created schemas);
-- `''` is the pre-provenance sentinel the writer's per-cycle backfill sweeps to the live event id.
-- The last four columns carry the DEVICE MANIFEST's presentation detail (capability `sync-ledger`),
-- `absent` records that the asset has LEFT the library; the row itself is kept, because its bytes are
-- still on the backend and that row is what suppresses re-upload if the asset is restored. `DEFAULT 0`
-- must match 6.sqm exactly. Reads that answer "what does this device currently hold or share" exclude
-- absent rows; `get` does NOT, so suppression survives a deletion.
-- so the manifest is a projection of this table's COMPLETED rows rather than a parallel accumulator
-- that tracked the same deletion-aware asset set with different columns. `DEFAULT ''` must match
-- 5.sqm exactly (the verify task compares migrated vs created schemas); `''` is the "not yet
-- enriched" sentinel that a re-join seed and a pre-5.sqm row both start in, swept by
-- `backfillManifestDetail`.
CREATE TABLE ledgerRow (
    key TEXT NOT NULL PRIMARY KEY,
    assetId TEXT NOT NULL,
    state TEXT AS LedgerState NOT NULL,
    attempt INTEGER NOT NULL,
    eventId TEXT NOT NULL DEFAULT '',
    creationDate TEXT NOT NULL DEFAULT '',
    role TEXT NOT NULL DEFAULT '',
    contentType TEXT NOT NULL DEFAULT '',
    originalFilename TEXT NOT NULL DEFAULT '',
    absent INTEGER NOT NULL DEFAULT 0,
    -- The destination this row's upload was addressed to, or NULL for a row recorded before the column
    -- existed. NULLABLE must match 7.sqm exactly (the verify task compares migrated vs created schemas).
    destinationPath TEXT
);

CREATE INDEX ledgerRow_assetId ON ledgerRow(assetId);

-- The ack path resolves a returned upload job to its row through this index; without it every returned
-- job would scan the table, on a path the OS invokes with a deadline.
CREATE INDEX ledgerRow_destinationPath ON ledgerRow(destinationPath);

-- Deliberately does NOT filter `absent`: a row for a departed asset still records that its bytes are on
-- the backend, which is what suppresses re-upload should the asset be restored (iOS keeps deleted photos
-- recoverable for 30 days - the same order as an event's life).
get:
SELECT key, assetId, state, attempt, eventId, creationDate, role, contentType, originalFilename, absent, destinationPath
FROM ledgerRow
WHERE key = :key;

put:
INSERT OR REPLACE INTO ledgerRow (
    key, assetId, state, attempt, eventId, creationDate, role, contentType, originalFilename, absent,
    destinationPath
)
VALUES (
    :key, :assetId, :state, :attempt, :eventId, :creationDate, :role, :contentType, :originalFilename,
    :absent, :destinationPath
);

-- Resolve a row from the destination its upload was addressed to (capability `ios-photokit-upload`).
-- A NULL column never matches, which is correct: such a row predates the write and is recovered by the
-- tier's fallback instead.
selectByDestinationPath:
SELECT key, assetId, state, attempt, eventId, creationDate, role, contentType, originalFilename, absent, destinationPath
FROM ledgerRow
WHERE destinationPath = :destinationPath;

-- Fill the manifest detail of ONE already-recorded row, without touching its state or attempt.
-- The sweep for rows a migration could not fill and for rows the re-join reconcile seeded from a
-- filename listing (which carries no capture date). Touches only bare rows: a row already enriched
-- is never rewritten, so re-running is free and cannot clobber a good value with a worse one.
backfillManifestDetail:
UPDATE ledgerRow
SET creationDate = :creationDate,
    role = :role,
    contentType = :contentType,
    originalFilename = :originalFilename
WHERE key = :key AND creationDate = '';

-- The SETTLED rows that carry manifest detail — the device manifest, projected. Rows still bare
-- (`creationDate = ''`) are excluded: they are mid-backfill, and listing a resource with no capture
-- date would put it outside every membership window rather than inside the right one.
--
-- `:doneStates` is bound from Kotlin's `LedgerState.isDone` rather than written as a literal here, so a
-- state added later must be classified in one compile-checked place instead of landing silently on one
-- side of this predicate. It resolves to exactly `COMPLETED` today, so the projection is unchanged; an
-- UPLOADED row is deliberately NOT settled and stays out of the manifest until the cycle promotes it.
-- `state` is selected so the mapper reads it rather than asserting it (it used to hardcode COMPLETED,
-- which a second settled state would have made a lie).
selectCompletedManifestRows:
SELECT key, assetId, state, creationDate, role, contentType, originalFilename
FROM ledgerRow
WHERE state IN :doneStates AND creationDate != '' AND absent = 0;

-- Rewrite the provenance of every pre-provenance row (`eventId = ''` — rows recorded by a build
-- before 4.sqm, or by a staged-revert build) to the live event id. Touches ONLY the sentinel:
-- rows already carrying a real eventId are never rewritten.
backfillEventId:
UPDATE ledgerRow
SET eventId = :eventId
WHERE eventId = '';

deleteAll:
DELETE FROM ledgerRow;

-- Delete the REQUESTED rows: the recovery after an extension disable wipes the OS's in-flight upload
-- jobs. Those resources are orphaned (the engine never re-issues a REQUESTED key), so dropping them
-- lets the next discovery re-create the not-yet-stored ones. COMPLETED/FAILED rows are untouched.
deleteRequested:
DELETE FROM ledgerRow
WHERE state = 'REQUESTED';

-- Record that one asset has left the library (rides the assetId index). An UPDATE, never a DELETE: the
-- row's statement — "these bytes are on the backend" — stays true, and keeping it is what stops a
-- restored asset re-uploading. Idempotent, so re-running on an already-marked asset is free.
markAbsent:
UPDATE ledgerRow
SET absent = 1
WHERE assetId = :assetId;

-- The non-COMPLETED rows (the backlog) as (assetId, key) pairs. The status overlay groups these by
-- photo in Kotlin to intersect outstanding resources with observed completions, without
-- materializing the (large, static) completed set. Shrinks as sync drains.
selectPending:
SELECT assetId, key FROM ledgerRow
WHERE state NOT IN :doneStates AND absent = 0;

-- Aggregates counted by PHOTO (assetId), not resource row: collapse rows to assets first, then
-- count. A photo is complete only when none of its rows is non-COMPLETED.
aggregates:
WITH perAsset AS (
    SELECT assetId,
           SUM(CASE WHEN state NOT IN :doneStates THEN 1 ELSE 0 END) AS notDone
    FROM ledgerRow
    WHERE absent = 0
    GROUP BY assetId
)
SELECT
    COUNT(CASE WHEN notDone > 0 THEN 1 END) AS pending,
    COUNT(CASE WHEN notDone = 0 THEN 1 END) AS completed
FROM perAsset;

-- Flip ONE row's state, but only while it is still REQUESTED — the guarded terminal write
-- (capability `sync-ledger`). Two writers reach this row holding no shared lock: a platform callback on
-- the platform's own queue, and the upload cycle on the composition lane. A read-then-write pair is not
-- atomic against the one that does not take the lock, so the guard lives in the statement.
--
-- Every other column is preserved by construction — this is an UPDATE of one column, not an upsert, so
-- assetId, attempt, eventId and all four manifest columns cannot be blanked by a caller that does not
-- know them. That matters: the party that learns an upload terminated is a delegate holding only the key.
markTerminal:
UPDATE ledgerRow
SET state = :state
WHERE key = :key AND state = 'REQUESTED';

-- How many rows the statement immediately before it changed, read INSIDE that statement's own
-- transaction — the same mechanism `DownloadStore.sq` uses for its three callback writes, and for the
-- same reason: "did this take effect?" is a real question here. A `markTerminal` that matches nothing
-- means the row moved on (already terminal, or pruned), which is a different fact from "recorded" and
-- may not be silent (`module-architecture`, "Absence is never silent").
changedRows:
SELECT changes();

-- The rows whose bytes are stored but whose completion work has not run — what the cycle's promotion
-- pass consumes. Whole rows, not keys: the pass needs `assetId` for the event-album placement, and the
-- manifest detail travels with the row so promoting it cannot blank what it already carries.
--
-- Deliberately NOT filtered by `absent`. An asset can leave the library between the upload landing and
-- the cycle that promotes it, and the row is still true — the bytes are on the backend, which is the one
-- thing `absent` does not change. Excluding it would leave the row resting `UPLOADED` for good, invisible
-- to every other read (they all filter `absent`), and never settled. The album placement it triggers is
-- best-effort and simply finds no asset to add.
selectUploaded:
SELECT key, assetId, state, attempt, eventId, creationDate, role, contentType, originalFilename, absent, destinationPath
FROM ledgerRow
WHERE state = 'UPLOADED';

-- Settle an UPLOADED row once the work a completion triggers has run. Guarded like `markTerminal`, and
-- for the same reason: it is an UPDATE of ONE column, so every other fact about the row — provenance,
-- attempt, the manifest detail, and whether the asset has since left the library — survives by
-- construction rather than by a caller remembering to re-state it. The earlier version re-stated the row
-- in full and would have dropped `absent` the moment that column arrived.
promoteUploaded:
UPDATE ledgerRow
SET state = 'COMPLETED'
WHERE key = :key AND state = 'UPLOADED';

-- The REQUESTED keys — the candidates for stranded reconciliation (capability
-- `ios-url-session-upload`). Deliberately NOT the whole non-settled backlog: a FAILED row has already
-- been adjudicated, and re-surfacing it every cycle re-writes the row, signals a change, and reports a
-- loss that did not happen. That defect put one key in a device log as "stranded" twelve times inside a
-- single process, seven of them within sixteen seconds.
selectRequestedKeys:
SELECT key FROM ledgerRow
WHERE state = 'REQUESTED';

-- The rows that need an upload job — the upload cycle's source of work (capability `sync-ledger`).
--
-- `:needsJobStates` is bound from Kotlin's `LedgerState.needsJob` rather than written as a literal here,
-- for the same reason `:doneStates` is: a state added without classifying it would otherwise land
-- silently on one side of a string comparison, and this query is the one that decides whether the cycle
-- ever looks at it again.
--
-- Filtered by `absent`, unlike `selectUploaded`: a departed asset has no bytes left to read, so there is
-- nothing to upload from. `selectUploaded` keeps its absent rows because their bytes ARE on the backend
-- and the row still owes a promotion; a row that needs a job owes an upload, which a departed asset can
-- no longer supply.
--
-- Ordered by key so the bound below takes a deterministic slice rather than whatever the storage engine
-- happened to return, and LIMITed because a first walk on a large library records a row per outstanding
-- resource and a cycle that tried to enqueue all of them would stage every one to disk.
selectNeedingJob:
SELECT key, assetId, state, attempt, eventId, creationDate, role, contentType, originalFilename, absent, destinationPath
FROM ledgerRow
WHERE state IN :needsJobStates AND absent = 0
ORDER BY key
LIMIT :limit;

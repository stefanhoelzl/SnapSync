import app.snapsync.ports.DownloadState;

-- One row per foreign asset this device is downloading / has imported (capability `download-store`).
-- Keyed by the SOURCE identity (the owning device + that device's assetId), which is stable across
-- syncs and events — so idempotency and cross-event dedup are by (sourceDeviceId, sourceAssetId).
-- `createdLocalId` is the local PHAsset identifier minted at import; it is the suppression handle the
-- upload extension reads to avoid re-uploading a downloaded asset. Null until imported.
CREATE TABLE downloadAsset (
    sourceDeviceId TEXT NOT NULL,
    sourceAssetId  TEXT NOT NULL,
    state          TEXT AS DownloadState NOT NULL,
    creationDate   TEXT NOT NULL,
    createdLocalId TEXT,
    PRIMARY KEY (sourceDeviceId, sourceAssetId)
);

-- The created-local-id suppression projection rides this partial index (only imported rows carry one).
CREATE INDEX downloadAsset_createdLocalId ON downloadAsset(createdLocalId);

-- One row per expected resource of a downloading asset. `stagedPath` is null until the resource's
-- bytes are downloaded and moved to durable App-Group staging; an asset is complete (importable) when
-- every expected resource has a non-null `stagedPath`.
CREATE TABLE downloadResource (
    sourceDeviceId TEXT NOT NULL,
    sourceAssetId  TEXT NOT NULL,
    resourceKey    TEXT NOT NULL,
    url            TEXT NOT NULL,
    role           TEXT NOT NULL,
    contentType    TEXT NOT NULL,
    originalFilename TEXT NOT NULL,
    stagedPath     TEXT,
    -- 1 once this resource's download has been SENT to the OS (a background URLSession task exists).
    -- Combined with `stagedPath IS NULL` it means "in flight" — the download analogue of the upload
    -- ledger's REQUESTED. Superseded implicitly once `stagedPath` becomes non-null.
    enqueued       INTEGER NOT NULL DEFAULT 0,
    PRIMARY KEY (sourceDeviceId, sourceAssetId, resourceKey)
);

-- --- asset lifecycle ---

upsertAsset:
INSERT OR IGNORE INTO downloadAsset (sourceDeviceId, sourceAssetId, state, creationDate, createdLocalId)
VALUES (:sourceDeviceId, :sourceAssetId, :state, :creationDate, NULL);

selectAssetState:
SELECT state FROM downloadAsset
WHERE sourceDeviceId = :sourceDeviceId AND sourceAssetId = :sourceAssetId;

markImported:
UPDATE downloadAsset
SET state = 'IMPORTED', createdLocalId = :createdLocalId
WHERE sourceDeviceId = :sourceDeviceId AND sourceAssetId = :sourceAssetId;

-- Record ONLY the created local id (suppression handle), leaving state PENDING. Written synchronously
-- INSIDE the PhotoKit change block — before the new asset can be observed by upload discovery — so the
-- echo is closed even if the import's completion (which sets state=IMPORTED) lands later or fails.
recordCreatedLocalId:
UPDATE downloadAsset
SET createdLocalId = :createdLocalId
WHERE sourceDeviceId = :sourceDeviceId AND sourceAssetId = :sourceAssetId;

-- The mirror of `recordCreatedLocalId`, for a change the library reported as FAILED. A marker is cleared
-- for exactly one reason: the library said its change failed. Never because time passed, because nothing
-- is awaiting the transaction any longer, or because a presence lookup answered *absent* while that
-- transaction was still open — it may still commit, and clearing it orphans the asset it creates.
--
-- GUARDED, exactly like `confirmCreatedLocalId` below and for the same reason: two writers reach this with
-- no shared lock, so the guard belongs in the `WHERE` clause and not in a caller's `if`. It matches only a
-- row that is still non-terminal AND still carries the marker this clear was computed for. Without the
-- state guard a late failure completion strips the marker off a row that adjudication has already settled
-- as PRESENT — and that row is terminal, so it is never adjudicated or re-imported again and its asset
-- stays in the library permanently unsuppressed.
clearCreatedLocalId:
UPDATE downloadAsset
SET createdLocalId = NULL
WHERE sourceDeviceId = :sourceDeviceId
  AND sourceAssetId = :sourceAssetId
  AND state != 'IMPORTED'
  AND createdLocalId = :createdLocalId;

-- The SUCCESS mirror: the completion callback settles the row itself, against the marker it already
-- holds. `createdLocalId` is deliberately NOT re-written — the guard below already proves the row carries
-- it, and re-writing is how a stale completion could overwrite a newer marker.
--
-- The `createdLocalId = :createdLocalId` guard is what makes a LATE completion safe: if the marker was
-- cleared and the asset re-imported under a new one, this matches no row and settles nothing. It lives
-- in the WHERE clause rather than in a caller's `if` because two writers reach this with no shared lock.
confirmCreatedLocalId:
UPDATE downloadAsset
SET state = 'IMPORTED'
WHERE sourceDeviceId = :sourceDeviceId
  AND sourceAssetId = :sourceAssetId
  AND createdLocalId = :createdLocalId;

-- How many rows the statement immediately before it changed, read INSIDE that statement's own transaction.
--
-- This is how a non-suspending marker write reports whether it applied (capability `download-store`). The
-- three callback writes cannot suspend — PhotoKit's change and completion blocks cannot call a suspending
-- function — and two of them are guarded, so "did this take effect?" is a real question with two different
-- consequences: a guarded write that matched nothing means the row moved on and the caller must not act on
-- its verdict, while `recordCreatedLocalId` matching nothing means the row was DELETED and the asset it is
-- about to create will have no suppression handle at all.
--
-- It replaces a marker-scoped read the caller used to take before writing. That pair was never atomic
-- against the photo library's completion callback, which writes from the platform's own queue and takes no
-- lock; asking the database what it just did, in the same transaction, is.
changedRows:
SELECT changes();

isImported:
SELECT EXISTS(
    SELECT 1 FROM downloadAsset
    WHERE sourceDeviceId = :sourceDeviceId AND sourceAssetId = :sourceAssetId
      AND state = 'IMPORTED'
);

-- The suppression set the upload extension reads (read-only): every created local id of an imported
-- foreign asset. Never upload these — they would echo back into storage under this device.
suppressedLocalIds:
SELECT createdLocalId FROM downloadAsset
WHERE createdLocalId IS NOT NULL;

countImported:
SELECT COUNT(*) FROM downloadAsset WHERE state = 'IMPORTED';

-- Every foreign asset known for download (pending + imported) — the download-progress denominator.
countAssets:
SELECT COUNT(*) FROM downloadAsset;

-- The rows a prune would drop: non-terminal and carrying no `createdLocalId`. Read inside the prune's own
-- transaction so the caller can subtract the refs whose imports are in flight and free exactly the files it
-- strands (capability `download-store`).
--
-- A row that carries a marker is NEVER prunable. The marker is the record that an asset was created for
-- this ref, and it is the only thing keeping that asset out of the upload universe; deleting the row
-- destroys it, and the created asset is then uploaded back into the event. The invariant is
-- "handle-carrying rows are permanent", not "terminal rows are permanent".
selectPrunableAssets:
SELECT sourceDeviceId, sourceAssetId FROM downloadAsset
WHERE state != 'IMPORTED' AND createdLocalId IS NULL;

-- Drop ONE prunable row. Per-row rather than one bulk delete because a prune must spare the refs whose
-- imports are claimed but whose change blocks have not run yet: those rows carry no marker, so no
-- state-based predicate can tell them from ordinary prunable ones, and deleting one makes its marker write
-- land on nothing.
--
-- The predicate is restated so this can never delete a row that must be kept, whatever the caller passes.
-- That is safe ONLY because the stranded paths are read AFTER these deletes, from the resource rows this
-- delete orphaned — never from the pre-delete snapshot. Reading them first and re-checking here would be
-- the worst of both: a row this predicate spared would still have its files freed, and a resource recorded
-- as staged is never re-downloaded, so that photo would be permanently unimportable.
deletePrunableAsset:
DELETE FROM downloadAsset
WHERE sourceDeviceId = :sourceDeviceId AND sourceAssetId = :sourceAssetId
  AND state != 'IMPORTED' AND createdLocalId IS NULL;

-- The rows whose import was never confirmed: an asset WAS created for them (the marker was written
-- inside the change block, which always completes before the library commits) but the confirmation
-- never arrived — a process death, or an import still running whose completion has not come. The import path adjudicates
-- these against the photo library instead of importing them again.
selectUnconfirmedAssets:
SELECT sourceDeviceId, sourceAssetId, createdLocalId FROM downloadAsset
WHERE state != 'IMPORTED' AND createdLocalId IS NOT NULL;

deleteNonTerminalResources:
DELETE FROM downloadResource
WHERE NOT EXISTS (
    SELECT 1 FROM downloadAsset a
    WHERE a.sourceDeviceId = downloadResource.sourceDeviceId
      AND a.sourceAssetId = downloadResource.sourceAssetId
);

-- --- resource staging ---

-- Insert a new pending resource, or — on a re-plan of an existing one — refresh its `url` ONLY while it
-- is not yet staged (stagedPath IS NULL), so a freshly presigned download URL supersedes an expiring one
-- for work still pending. A staged row is left untouched (no re-download); the other fields are immutable
-- per resourceKey.
upsertResource:
INSERT INTO downloadResource
    (sourceDeviceId, sourceAssetId, resourceKey, url, role, contentType, originalFilename, stagedPath)
VALUES (:sourceDeviceId, :sourceAssetId, :resourceKey, :url, :role, :contentType, :originalFilename, NULL)
ON CONFLICT (sourceDeviceId, sourceAssetId, resourceKey)
DO UPDATE SET url = excluded.url
WHERE downloadResource.stagedPath IS NULL;

markResourceStaged:
UPDATE downloadResource
SET stagedPath = :stagedPath
WHERE sourceDeviceId = :sourceDeviceId AND sourceAssetId = :sourceAssetId AND resourceKey = :resourceKey;

-- Mark a resource's download as sent to the OS (a background URLSession task now exists).
markResourceEnqueued:
UPDATE downloadResource
SET enqueued = 1
WHERE sourceDeviceId = :sourceDeviceId AND sourceAssetId = :sourceAssetId AND resourceKey = :resourceKey;

-- Foreign assets with at least one resource in flight — enqueued to the OS but not yet staged — and
-- not yet imported. The download analogue of the upload ledger's in-flight `pending` (asset-counted).
countInFlightAssets:
SELECT COUNT(*) FROM downloadAsset a
WHERE a.state != 'IMPORTED'
  AND EXISTS (
      SELECT 1 FROM downloadResource r
      WHERE r.sourceDeviceId = a.sourceDeviceId AND r.sourceAssetId = a.sourceAssetId
        AND r.enqueued = 1 AND r.stagedPath IS NULL
  );

selectResourcesForAsset:
SELECT resourceKey, url, role, contentType, originalFilename, stagedPath
FROM downloadResource
WHERE sourceDeviceId = :sourceDeviceId AND sourceAssetId = :sourceAssetId;

-- Resources not yet staged across all non-imported assets — the download work queue.
selectPendingResources:
SELECT r.sourceDeviceId, r.sourceAssetId, r.resourceKey, r.url, r.role, r.contentType, r.originalFilename
FROM downloadResource r
JOIN downloadAsset a
  ON a.sourceDeviceId = r.sourceDeviceId AND a.sourceAssetId = r.sourceAssetId
WHERE r.stagedPath IS NULL AND a.state != 'IMPORTED';

-- Assets whose every expected resource is staged but not yet imported — ready to import.
--
-- `createdLocalId IS NULL` is part of the gate, not a refinement of it: a row carrying a marker already
-- has an asset in the library, and importing it again is precisely the duplicate this capability exists
-- to prevent. Those rows leave through `selectUnconfirmedAssets` to be adjudicated, and re-enter here
-- only once their marker has been cleared (capability `photo-download`).
selectImportableAssets:
SELECT a.sourceDeviceId, a.sourceAssetId, a.creationDate
FROM downloadAsset a
WHERE a.state != 'IMPORTED'
  AND a.createdLocalId IS NULL
  AND NOT EXISTS (
      SELECT 1 FROM downloadResource r
      WHERE r.sourceDeviceId = a.sourceDeviceId AND r.sourceAssetId = a.sourceAssetId
        AND r.stagedPath IS NULL
  )
  AND EXISTS (
      SELECT 1 FROM downloadResource r
      WHERE r.sourceDeviceId = a.sourceDeviceId AND r.sourceAssetId = a.sourceAssetId
  );

-- --- staged-byte lifetime ---

-- The staged files of assets whose import is CONFIRMED. Their bytes are redundant: the photo is in the
-- library, and nothing reads an imported row's resources. Feeds the release pass, which also drops the
-- rows below — so a second pass finds nothing and the pass is self-extinguishing.
selectStagedPathsOfImportedAssets:
SELECT r.stagedPath FROM downloadResource r
JOIN downloadAsset a ON a.sourceDeviceId = r.sourceDeviceId AND a.sourceAssetId = r.sourceAssetId
WHERE a.state = 'IMPORTED' AND r.stagedPath IS NOT NULL;

-- The staged files of ONE asset, for the prune to return as it drops that asset's row. There is no
-- "paths of every prunable row" read any more: it was taken before the delete, at a different instant, over
-- a store the platform's change and completion blocks mutate without taking any lock — so a marker cleared
-- in that gap turned a row the read had protected into a row the prune deleted, leaving its files on disk
-- with nothing referencing them, unfindable and surviving relaunch. The prune now reads and deletes inside
-- one transaction and returns what it stranded.
-- The staged files of resource rows whose ASSET row is already gone — read after the prune's deletes, so
-- it names exactly the files those deletes stranded rather than the ones a pre-delete snapshot predicted.
selectStagedPathsOfOrphanedResources:
SELECT r.stagedPath FROM downloadResource r
WHERE r.stagedPath IS NOT NULL
  AND NOT EXISTS (
      SELECT 1 FROM downloadAsset a
      WHERE a.sourceDeviceId = r.sourceDeviceId AND a.sourceAssetId = r.sourceAssetId
  );

-- Drop one asset's resource rows once its bytes are released, so the store never records a staged path
-- for a file that no longer exists. Safe because no read consults an IMPORTED row's resources.
deleteResourcesForAsset:
DELETE FROM downloadResource
WHERE sourceDeviceId = :sourceDeviceId AND sourceAssetId = :sourceAssetId;

-- The bulk half of the reclaim: drop the resource rows of every confirmed asset at once. Paired with
-- `selectStagedPathsOfImportedAssets`, this is what makes the reclaim self-extinguishing — the rows that
-- made the work findable are gone, so a second pass selects nothing.
deleteResourcesOfImportedAssets:
DELETE FROM downloadResource
WHERE EXISTS (
    SELECT 1 FROM downloadAsset a
    WHERE a.sourceDeviceId = downloadResource.sourceDeviceId
      AND a.sourceAssetId = downloadResource.sourceAssetId
      AND a.state = 'IMPORTED'
);

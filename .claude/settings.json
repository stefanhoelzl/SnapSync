{
  "env": {
    "USBMUXD_SOCKET_ADDRESS": "/run/host/run/usbmuxd"
  },
  "permissions": {
    "allow": [
      "Bash(./gradlew:*)",
      "Bash(npx --yes @fission-ai/openspec@1.5.0:*)",
      "Bash(deno task:*)",
      "Bash(deno check:*)",
      "Bash(deno fmt:*)",
      "Bash(deno lint:*)",
      "Bash(deno test:*)",
      "Bash(gh workflow run ssh-mac.yml:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/scripts/device-guard\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}

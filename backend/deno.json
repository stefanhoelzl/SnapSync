{
  "name": "@snapsync/backend",
  "version": "0.1.0",
  "exports": "./src/main.ts",
  "tasks": {
    // Derive the landing page's screenshots from the committed raws (capability `marketing-site`).
    // `src/shots.generated.ts` is NOT committed — it is derived — so every task that reads src/ runs this
    // first, keeping a fresh clone with only Deno installed able to check, test and bundle.
    "shots": "deno run --allow-read --allow-write scripts/shots.ts",
    "test": "deno task shots && deno test",
    "check": "deno task shots && deno check src/*.ts",
    "bundle": "deno task shots && deno bundle src/main.ts -o dist/main.js",
    "lint": "deno lint",
    "fmt": "deno fmt"
  },
  "imports": {
    "@bunny.net/edgescript-sdk": "npm:@bunny.net/edgescript-sdk@^0.12.1",
    "hono": "npm:hono@^4.12",
    "aws4fetch": "npm:aws4fetch@^1",
    "@std/assert": "jsr:@std/assert@^1",
    "@std/encoding": "jsr:@std/encoding@^1",
    "@levischuck/tiny-cbor": "jsr:@levischuck/tiny-cbor@^0.2",
    "@peculiar/x509": "npm:@peculiar/x509@^1.12",
    // Squoosh's codecs as WASM — used ONLY by scripts/shots.ts at build time, never by the deployed
    // bundle. They derive the landing page's screenshots from the committed raws with no system
    // dependency, so the backend's checks stay runnable from a fresh clone with only Deno.
    "@jsquash/png": "npm:@jsquash/png@^3",
    "@jsquash/resize": "npm:@jsquash/resize@^2",
    "@jsquash/webp": "npm:@jsquash/webp@^1"
  },
  "fmt": {
    "lineWidth": 100,
    // `src/shots.generated.ts` is generated (and gitignored) — its formatting is scripts/shots.ts's
    // business, not a reviewer's.
    "exclude": ["src/landing.html", "src/shots.generated.ts"]
  },
  "lint": {
    "exclude": ["src/shots.generated.ts"]
  }
}

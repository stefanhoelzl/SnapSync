// Shared build configuration consumed by iosApp.xcodeproj.
APP_NAME = SnapSync
BUNDLE_ID = app.snapsync
// Apple Team ID — drives DEVELOPMENT_TEAM for signed device/TestFlight builds.
// Not a secret (visible in any shipped IPA); the simulator gate ignores it (CODE_SIGNING_ALLOWED=NO).
TEAM_ID = E9Z8BADH58
// Entitlements (path relative to SRCROOT = iosApp/): keychain-sharing (deeplink-config) AND the App
// Group group.app.snapsync (the background-upload extension's shared ledger container). Keychain
// groups need no portal registration; the App Group DOES — it must be registered in the Developer
// portal and enabled on the app.snapsync App ID, or signed device/TestFlight builds fail to
// provision (see the ios-background-upload change, task 2.x). The simulator gate ignores signing.
CODE_SIGN_ENTITLEMENTS = iosApp/iosApp.entitlements
// The compile-time upload host (PhotoKit forces BackgroundUploadURLBase to be baked, not runtime).
// Default is the inert dummy host: a plain push (incl. main → TestFlight) ships this and uploads
// nowhere. CI's archive step overrides it from the workflow_dispatch `upload_host` input to bake a
// local test host (e.g. http://192.168.x.y:9000) into a dev IPA. The `$()` splits the `//` so
// xcconfig does not treat the rest of the line as a comment (CLI overrides need no such trick).
BACKGROUND_UPLOAD_URL_BASE = https:/$()/dummy.invalid

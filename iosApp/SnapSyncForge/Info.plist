<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  The marketing-screenshot binary. Deliberately minimal: it renders one screen and nothing else.

	  It declares NO App Group, NO keychain group, NO associated domain and NO background modes,
	  because it has none of the code that would use them — it does not link :app:ios, so there is no
	  ledger, no Keychain identity, no universal-link handler and no upload extension in this bundle.
	  Its entitlements file is correspondingly empty of grants.
	-->
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!--
	  MANDATORY. Compose Multiplatform >= 1.7 hard-aborts at launch without it, and this target is by
	  definition a Compose-rendering one. The failure mode in `screenshots.yml` would be a capture job
	  dying with no obvious cause, so it is worth stating rather than inheriting.
	-->
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UILaunchScreen</key>
	<dict/>
	<!-- Portrait-only and iPhone-only, matching the app: a capture must frame like the real thing. -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UIRequiresFullScreen</key>
	<true/>
</dict>
</plist>

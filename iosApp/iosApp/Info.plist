<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- The compile-time upload host, shared with the extension via the BACKGROUND_UPLOAD_URL_BASE
	     build setting. The app itself never uploads; the extension does. Must be an HTTPS endpoint —
	     default ATS (HTTPS-only) applies, no NSAllowsLocalNetworking exception. -->
	<key>BackgroundUploadURLBase</key>
	<string>$(BACKGROUND_UPLOAD_URL_BASE)</string>
	<!-- Custom URL scheme: a QR scanned by the stock Camera app opens snapsync://config?… which
	     deeplinks into the app carrying the S3 config (see deeplink-config capability). -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>app.snapsync.config</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>snapsync</string>
			</array>
		</dict>
	</array>
	<!-- Required by Compose Multiplatform (>=1.7): the runtime hard-aborts at launch if this
	     is absent or not true. Also unlocks 120 Hz rendering on ProMotion devices. -->
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>SnapSync backs up your photo library to your private cloud storage.</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<!-- Portrait-only: the status UI has no landscape layout and is designed/previewed at fixed
	     iPhone-portrait proportions. The app targets iPhone only (TARGETED_DEVICE_FAMILY = 1), so
	     only this key is honored (no ~ipad variant) and it locks to a single upright portrait. Targeting
	     iPhone only also sidesteps the App Store iPad-multitasking rule (TMS-90474) that a universal app
	     declare all four orientations. -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
</dict>
</plist>

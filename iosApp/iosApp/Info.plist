<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- ONE deployment value lives here, because its reader is the OS rather than us. assetsd looks
	     BackgroundUploadURLBase up in a BUNDLE'S OWN Info.plist when it validates the background-upload
	     registration insert, and can see no resource we ship. The extension carries the same key for
	     the same reason (its Info.plist explains, and holds the measurement); the app carries it
	     because the registration call is made by THIS process and which bundle the daemon reads has
	     not been established — restoring both makes the question moot rather than betting on it.
	     Capability `ios-photokit-upload`.

	     It is COMPOSED from two build settings the resolver generates (a scheme enum and a bare host),
	     never carried as one URL-valued setting: an Info.plist substitution can only read a build
	     setting, and "//" opens a comment anywhere on an xcconfig line. The "//" lands here, where it
	     is data. ios.yml asserts what this composes to equals this bundle's Deployment.plist
	     `uploadBase`.

	     EVERY OTHER deployment value stays out of this file (capability deployment-configuration). The
	     APNs environment and the crash-reporting pair live in the GENERATED Deployment.plist, bundled
	     as a resource into this target and the extension's. They were moved because an xcconfig build
	     setting is the wrong carrier for a value containing "//": that silently truncated the
	     crash-reporting DSN to "https:" and shipped four mute TestFlight builds. Their rationale now
	     lives on the resolver's key inventory, where every toolchain that reads them can see it. -->
	<key>BackgroundUploadURLBase</key>
	<string>$(UPLOAD_SCHEME)://$(UPLOAD_HOST)/api/v2</string>
	<!-- No CFBundleURLTypes, deliberately: the `snapsync` custom scheme is retired (capability
	     `event-link`). An invite is now an HTTPS Universal Link, claimed via the associated-domains
	     entitlement rather than a scheme — which is what lets a QR scanned by someone who does NOT
	     have the app reach the App Store instead of dead-ending. Re-adding a scheme here would
	     resurrect a second URL form the one authoritative codec no longer accepts. -->
	<!-- Required by Compose Multiplatform (>=1.7): the runtime hard-aborts at launch if this
	     is absent or not true. Also unlocks 120 Hz rendering on ProMotion devices. -->
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>SnapSync syncs your photos with the events you join — sharing yours and saving the event's photos to your library.</string>
	<!-- Under a LIMITED (partial) grant iOS otherwise auto-presents its "Select More Photos / Keep
	     Current Selection" alert the first time the app touches the library in each session. SnapSync
	     re-fetches on every foreground and reconcile, so that alert fires over and over and makes the
	     app unusable (observed on device, 2026-07-20). Suppressing it makes the APP the owner of the
	     picker — see `presentLimitedLibraryPicker` in :adapter:ios:app-only, driven by the status
	     screen's "Choose more photos" affordance. Both halves are required: suppress without offering
	     the picker and a limited user can never widen their selection from inside the app. -->
	<key>PHPhotoLibraryPreventAutomaticLimitedAccessAlert</key>
	<true/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<!-- Portrait-only: the status UI has no landscape layout and is designed/previewed at fixed
	     iPhone-portrait proportions. The app targets iPhone only (TARGETED_DEVICE_FAMILY = 1), so
	     only this key is honored (no ~ipad variant) and it locks to a single upright portrait. Targeting
	     iPhone only also sidesteps the App Store iPad-multitasking rule (TMS-90474) that a universal app
	     declare all four orientations. -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<!-- Background processing for the photo-download import-tail backstop (capability photo-download):
	     a BGProcessingTask drains staged-but-unimported downloads at an idle/charging window when no
	     further URLSession download event would wake the app. The identifier MUST match the Swift
	     register(forTaskWithIdentifier:) call and SnapSyncRoot.DOWNLOAD_BACKSTOP_TASK_ID, or the
	     register call crashes at launch. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>processing</string>
		<!-- Silent (content-available) remote notifications wake the app in the background (capability
		     push-registration). Registered at launch; the AppDelegate forwards receipt to Kotlin. -->
		<string>remote-notification</string>
	</array>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>app.snapsync.download.backstop</string>
		<!-- The app-driven (iOS 18–26.0) upload heartbeat (capability ios-url-session-upload): tops up
		     the background URLSession queue + catches new captures while the app is closed. -->
		<string>app.snapsync.upload.heartbeat</string>
	</array>
</dict>
</plist>

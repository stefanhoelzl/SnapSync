<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Shared keychain group: the config Keychain item lands here (it is the only/default group),
	     so the future background upload extension — declaring the same group — reads the same S3
	     credentials. KeychainConfigStore omits kSecAttrAccessGroup and relies on this default.
	     Keychain groups need no portal registration (just the team prefix), so this entitlement
	     adds no manual App Store / Developer-portal step. -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)app.snapsync.shared</string>
	</array>
	<!-- App Group: the shared on-disk container for the ledger DB the background-upload extension
	     writes and the app reads (iosLedgerBackend). Unlike keychain groups, an App Group MUST be
	     registered in the Developer portal and enabled on the app.snapsync App ID, or signed builds
	     fail to provision (see the ios-background-upload change, task 2.x). -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.app.snapsync</string>
	</array>
</dict>
</plist>

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Shared keychain group: the config Keychain item lands here (it is the only/default group),
	     so the future background upload extension — declaring the same group — reads the same S3
	     credentials. KeychainConfigStore omits kSecAttrAccessGroup and relies on this default.
	     Keychain groups need no portal registration (just the team prefix), so this entitlement
	     adds no manual App Store / Developer-portal step. -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)app.snapsync.shared</string>
	</array>
	<!-- App Group: the shared on-disk container for the ledger DB the background-upload extension
	     writes and the app reads (iosLedgerStore). Unlike keychain groups, an App Group MUST be
	     registered in the Developer portal and enabled on the app.snapsync App ID, or signed builds
	     fail to provision (see the ios-background-upload change, task 2.x). -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.app.snapsync</string>
	</array>
	<!-- APNs environment for remote notifications (capability `push-registration`). Driven by the
	     APS_ENVIRONMENT build setting (the generated Deployment.xcconfig): `development` (APNs
	     sandbox) for dev/sideloaded builds, `production` for TestFlight/App Store — kept in lockstep
	     with the compile-time APNS_ENV the app reports in its device config. Push Notifications must
	     be enabled on the app.snapsync App ID in the Developer portal, or signed builds fail to
	     provision. -->
	<key>aps-environment</key>
	<string>$(APS_ENVIRONMENT)</string>
	<!-- Associated domain for the event link's Universal Link (capability `event-link`). Driven by the
	     ASSOCIATED_DOMAIN build setting (the generated Deployment.xcconfig), carrying the same host
	     as the app's generated LINK_ORIGIN and the AASA the backend serves — a :test:architecture
	     guard asserts all of them agree, because drift here is SILENT: iOS just declines to match and
	     every invite opens Safari instead of the app. Like App Groups and Push (and unlike keychain
	     groups), Associated Domains MUST be enabled on the app.snapsync App ID in the Developer
	     portal, or signed builds fail to provision. Enabling it invalidates existing profiles: CI
	     re-generates them (-allowProvisioningUpdates), but the ssh-mac loop's baked
	     DEV_PROVISIONING_PROFILE_BASE64 does not — a stale one yields an IPA whose links silently
	     open Safari.
	     The extension declares NO associated domain: it never handles URLs. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>$(ASSOCIATED_DOMAIN)</string>
	</array>
</dict>
</plist>

<?xml version="1.0" encoding="UTF-8"?>
<!-- Info.plist for the ExtensionKit background-upload extension. The extension point is declared via
     EXAppExtensionAttributes (ExtensionKit, iOS 26 model); the principal type is the @main
     BackgroundUploadExtension in code (no NSExtensionPrincipalClass). ⚠️ VERIFY the
     EXExtensionPointIdentifier value against the iOS 26.1 SDK when the target first builds on CI. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>SnapSync Backup</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<!-- Required by the background-upload subsystem for network-access validation; the system only
	     uploads to destinations under this host. Dummy host for this slice (nothing really uploads). -->
	<key>BackgroundUploadURLBase</key>
	<string>https://dummy.invalid</string>
	<key>EXAppExtensionAttributes</key>
	<dict>
		<key>EXExtensionPointIdentifier</key>
		<string>com.apple.photos.background-upload</string>
	</dict>
</dict>
</plist>

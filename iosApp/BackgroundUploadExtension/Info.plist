<?xml version="1.0" encoding="UTF-8"?>
<!-- Info.plist for the ExtensionKit background-upload extension. The extension point is declared via
     EXAppExtensionAttributes (ExtensionKit, iOS 26 model); the principal type is the @main
     BackgroundUploadExtension in code (no NSExtensionPrincipalClass). The EXExtensionPointIdentifier
     value is verified on device (real-s3-upload, build 70). -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>SnapSync Backup</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<!-- Required by the background-upload subsystem for network-access validation; the system only
	     uploads to destinations under this host. Compile-time (a runtime-configurable host is
	     impossible with this API): driven by the BACKGROUND_UPLOAD_URL_BASE build setting, which
	     defaults to the deployed HTTPS backend (Config.xcconfig) and is overridden only by a
	     workflow_dispatch `upload_host` (HTTPS-only) for a dev IPA. Must be an HTTPS endpoint —
	     default ATS (HTTPS-only) applies, no NSAllowsLocalNetworking exception. -->
	<key>BackgroundUploadURLBase</key>
	<string>$(BACKGROUND_UPLOAD_URL_BASE)</string>
	<!-- Crash reporting (capability crash-reporting): the extension process reads its OWN bundle;
	     same injection story as the app's Info.plist (empty = off; CI Release injects both). -->
	<key>SENTRY_DSN</key>
	<string>$(SENTRY_DSN)</string>
	<key>SENTRY_ENVIRONMENT</key>
	<string>$(SENTRY_ENVIRONMENT)</string>
	<key>EXAppExtensionAttributes</key>
	<dict>
		<key>EXExtensionPointIdentifier</key>
		<string>com.apple.photos.background-upload</string>
	</dict>
</dict>
</plist>

<?xml version="1.0" encoding="UTF-8"?>
<!-- Info.plist for the ExtensionKit background-upload extension. The extension point is declared via
     EXAppExtensionAttributes (ExtensionKit, iOS 26 model); the principal type is the @main
     BackgroundUploadExtension in code (no NSExtensionPrincipalClass). The EXExtensionPointIdentifier
     value is verified on device (real-s3-upload, build 70). -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>SnapSync Backup</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<!-- NO deployment values here, deliberately (capability deployment-configuration) — see the
	     app's Info.plist for why. This process reads its OWN bundle, so the generated
	     Deployment.plist is copied into the .appex as well as the .app; a copy that reached only one
	     of them is a reachable state, and the one ios.yml asserts against both. -->
	<key>EXAppExtensionAttributes</key>
	<dict>
		<key>EXExtensionPointIdentifier</key>
		<string>com.apple.photos.background-upload</string>
	</dict>
</dict>
</plist>

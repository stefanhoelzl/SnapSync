<?xml version="1.0" encoding="UTF-8"?>
<!-- Info.plist for the ExtensionKit background-upload extension. The extension point is declared via
     EXAppExtensionAttributes (ExtensionKit, iOS 26 model); the principal type is the @main
     BackgroundUploadExtension in code (no NSExtensionPrincipalClass). ⚠️ VERIFY the
     EXExtensionPointIdentifier value against the iOS 26.1 SDK when the target first builds on CI. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>SnapSync Backup</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<!-- Required by the background-upload subsystem for network-access validation; the system only
	     uploads to destinations under this host. Compile-time (a runtime-configurable host is
	     impossible with this API): driven by the BACKGROUND_UPLOAD_URL_BASE build setting, which
	     defaults to the inert dummy host and is overridden by CI's workflow_dispatch `upload_host`
	     to bake a local test host into a dev IPA. -->
	<key>BackgroundUploadURLBase</key>
	<string>$(BACKGROUND_UPLOAD_URL_BASE)</string>
	<!-- Permit a plaintext PUT to a private/local upload host (the local-S3 test rig). Narrow:
	     relaxes ATS only for private/local/.local addresses; the public HTTPS endpoint is
	     unaffected, so this is safe to ship in every config (the dev IPA is exported from the same
	     Release archive as TestFlight). -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>EXAppExtensionAttributes</key>
	<dict>
		<key>EXExtensionPointIdentifier</key>
		<string>com.apple.photos.background-upload</string>
	</dict>
</dict>
</plist>

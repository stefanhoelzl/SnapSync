<?xml version="1.0" encoding="UTF-8"?>
<!-- Entitlements for the background-upload extension target. The App Group is the shared ledger
     container it writes (the app reads it); the keychain group lets it read the same S3 credentials
     the app stores (consumed by a later, real-upload slice). The App Group MUST be registered in the
     Developer portal and enabled on the extension's App ID (app.snapsync.BackgroundUpload), same as
     the app — see the ios-background-upload change, task 2.3. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.app.snapsync</string>
	</array>
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)app.snapsync.shared</string>
	</array>
</dict>
</plist>

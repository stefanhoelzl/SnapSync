<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Development export: a dev-signed IPA that installs directly on registered devices
	     (sideload via the usbmuxd bridge). No TestFlight. Xcode 26 renamed this method's value
	     from "development" to "debugging" (the old spelling warns as deprecated). -->
	<key>method</key>
	<string>debugging</string>
	<!-- Apple Team ID (same value as TEAM_ID in the generated Configuration/Deployment.xcconfig). -->
	<key>teamID</key>
	<string>E9Z8BADH58</string>
	<!-- Auto-managed signing: xcodebuild -allowProvisioningUpdates reuses the imported Apple
	     Development cert and cloud-manages a development profile that includes registered devices. -->
	<key>signingStyle</key>
	<string>automatic</string>
	<key>destination</key>
	<string>export</string>
	<!-- We own the build number (github.run_number); do not let Xcode rewrite it. -->
	<key>manageAppVersionAndBuildNumber</key>
	<false/>
	<key>uploadSymbols</key>
	<true/>
</dict>
</plist>

.gradle/
build/
gradle/wrapper/gradle-wrapper.jar
local.properties
*.hprof
.idea/
.kotlin/

# backend bundle output (built in CI, deployed; never committed)
api/dist/

# Local backend rig (dev infrastructure): the filesystem store the api runs against locally, plus the
# tunnel host file and a downloaded cloudflared. Wiping api/.localstore is the reset — the deliberate
# INVERSE of the production rule, where no whole-zone reset tool exists because that one zone holds real
# users' photos. This one holds nothing.
api/.localstore/
api/.localdev/

# Derived from the committed raws in screenshots/ by `deno task shots` (capability marketing-site).

# Python bytecode caches (e.g. .github/scripts/) — build output, never committed.
__pycache__/
*.py[cod]

# Per-machine Claude Code overrides. `.claude/settings.json` IS committed: every CodeHydra workspace
# is a fresh worktree, so anything left untracked exists in none of them.
.claude/settings.local.json

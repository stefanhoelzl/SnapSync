-- v13 -> v14: a received photo keeps when its bytes were downloaded and when it was added to the library, with the entry
-- point that added it, until the `received` report has told the service — the delivery record's `downloaded` and
-- `added` (decision record `changes/delivery-record`, D3).
--
--   downloadedAt      when the photo's last resource was staged — NULL until then
--   addedAt, addedBy  when the import into the library completed, and the entry point that ran it — NULL until then
--   deliveryReported  1 once a report the service recorded carried these facts; never reported again
--
-- Row-preserving: the timestamps are nullable and a row already imported has none, so it is never reported — no fact is
-- guessed for it. DOWNGRADE: an earlier build names none of the four columns, so it reads and writes the table as before.

ALTER TABLE downloadAsset ADD COLUMN downloadedAt TEXT;
ALTER TABLE downloadAsset ADD COLUMN addedAt TEXT;
ALTER TABLE downloadAsset ADD COLUMN addedBy TEXT;
ALTER TABLE downloadAsset ADD COLUMN deliveryReported INTEGER NOT NULL DEFAULT 0;

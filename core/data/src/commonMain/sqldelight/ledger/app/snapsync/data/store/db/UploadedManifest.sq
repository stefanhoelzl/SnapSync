-- `uploadedManifest` — the device manifest the backend last took (capability `photo-sharing`): the record the app and
-- the extension both compare a fresh one against before publishing, and the two facts the core reads of it — what it
-- declared of the share, and how many photos. At most one row, `id = 0`.

selectUploaded:
SELECT eventId, version, manifest, declaration, assets FROM uploadedManifest WHERE id = 0;

-- Monotonic: a record never moves to an OLDER version of the same event. Two cycles can publish crossing in the
-- network; the backend keeps the newer, and so does this — an older record landing last would only cost a republish,
-- but now it cannot land at all (decision record `changes/manifest-versions`, D3).
recordUploaded:
INSERT INTO uploadedManifest (id, eventId, version, manifest, declaration, assets)
VALUES (0, :eventId, :version, :manifest, :declaration, :assets)
ON CONFLICT (id) DO UPDATE SET eventId = excluded.eventId, version = excluded.version, manifest = excluded.manifest,
    declaration = excluded.declaration, assets = excluded.assets
WHERE excluded.eventId != uploadedManifest.eventId OR excluded.version >= uploadedManifest.version;

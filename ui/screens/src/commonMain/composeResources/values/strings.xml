    <string name="explain_hint_caption">Open SnapSync and they catch up.</string>
    <string name="explain_settings_link">Settings</string>
    <string name="explain_access_link">Allow photo access</string>
    <string name="show_qr">QR code</string>
    <string name="qr_sheet_title">Join %1$s</string>
</resources>
